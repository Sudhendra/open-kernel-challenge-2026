# okloop configuration (sourced by bash; read by loop.py). Copy to config.env and fill in.
ROOT=/path/to/this/repo
TRACK=muse_decode_layer
PROBLEM=muse_decode_layer

# Box A = judge (timing). Box B optional (compile + correctness). Empty B = everything on A.
BOX_A=user@gpu-box-a
BOX_B=
SSH_KEY=$HOME/.ssh/id_ed25519
REMOTE_DIR=/home/user/okc
IMAGE=lmsysorg/sglang:dev-muse-spark-open

# Gate
REPS=20                 # paired cold-L2 reps per timing run (two runs per candidate)
KEEP_MIN=0.003          # floor on required gain (fraction) when 2*A/A band is smaller
COLD_COMPILE_S=270      # prepare() must finish under this on a cold cache (judge allows 300)
AA_BAND_DEFAULT=0.008   # used until `okloop aa` has measured the real band

# Attempts
ATTEMPT_MINUTES=45
CLAUDE_MODEL=claude-sonnet-5-5
RESEARCH_MODEL=claude-sonnet-5-5
CODEX_MODEL=gpt-6-astra
OPENCODE_MODEL=deepseek/deepseek-v4-pro#max

# Lanes: name:provider  (providers: claude | codex | opencode). One attempt at a time per lane.
LANES="ports:codex"
RESEARCH_PROVIDER=claude
RESEARCH_EVERY_MIN=180

# Submissions: auto | manual. AUTO_SLOTS scored runs/day go without approval; the rest wait for `okloop approve`.
SUBMIT=auto
AUTO_SLOTS=8
SUBMIT_MIN_GAIN=0.005   # local gain over the last submitted file required before spending a scored run

GATE_USE_B=0
