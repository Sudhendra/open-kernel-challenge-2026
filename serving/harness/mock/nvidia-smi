#!/usr/bin/env bash
case "$*" in
  *-lms*) while :; do for i in 0 1 2 3 4 5 6 7; do echo "$i, $(( ${MOCK_MEM_MIB:-120000} + i ))"; done; sleep 0.5; done;;
  *memory.used*) for i in 0 1 2 3 4 5 6 7; do echo 0; done;;
  *"-l 1"*) while :; do echo "mock,0,0,100,0"; sleep 1; done;;
  *topo*) echo "mock topo";;
  *) echo "index, name, memory.total [MiB]"; for i in 0 1 2 3 4 5 6 7; do echo "$i, MOCK-GPU, 141000 MiB"; done;;
esac
