--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/muse_spark_fp4_grouped_moe.py
@@ -0,0 +1,229 @@
+"""Grouped NVFP4 routed experts for Muse Spark in place of Marlin W4A16, from one weight copy; layout and runner in ``kernels/jit/csrc/moe/muse_spark_fp4_grouped.cuh``."""
+
+from __future__ import annotations
+
+from enum import IntEnum
+
+import torch
+
+from sglang.srt.layers.utils import copy_or_rebind_param
+from sglang.srt.utils.common import print_info_once, print_warning_once
+
+_LOCAL_EXPERTS = 32
+_HIDDEN = 4096
+_INTERMEDIATE = 4096
+_TOP_K = 8
+_GROUP_SIZE = 16
+_K_STAGES = 64
+_K_STAGE_BYTES = 4608  # 4096 code bytes + 512 scale bytes
+_N_TILE_ROWS = 128
+_COMPUTE_CAPABILITY = (9, 0)
+
+_CODE_BIT_POSITIONS = (
+    (6, 7, 8, 15),
+    (22, 23, 24, 31),
+    (28, 29, 30, 5),
+    (12, 13, 14, 21),
+    (2, 3, 4, 11),
+    (18, 19, 20, 27),
+    (0, 1, 26, 9),
+    (16, 17, 10, 25),
+)
+
+
+class ScaleDecode(IntEnum):
+    """Block-scale decode that is exact for a tensor's E4M3 scale bytes."""
+
+    FAST = 0  # bytes in 0x08..0x7E, plus 0x00 whose codes the repack zeroes
+    EXACT = 1  # some subnormal bytes 0x01..0x07
+    UNSUPPORTED = 2  # NaN 0x7F or negative bytes; the layer stays on Marlin
+
+
+def should_use_grouped_fp4(
+    *,
+    use_marlin: bool,
+    capability: tuple[int, int] | None,
+    num_local_experts: int,
+    hidden_size: int,
+    intermediate_size: int,
+    top_k: int,
+    group_size: int,
+) -> bool:
+    """Whether this experts layer can use the grouped kernel instead of Marlin."""
+    if not use_marlin:
+        return False
+    fits = (
+        capability == _COMPUTE_CAPABILITY
+        and num_local_experts == _LOCAL_EXPERTS
+        and hidden_size == _HIDDEN
+        and intermediate_size == _INTERMEDIATE
+        and top_k == _TOP_K
+        and group_size == _GROUP_SIZE
+    )
+    print_info_once(
+        "Muse NVFP4 experts: "
+        + ("grouped NVFP4 MoE kernel." if fits else "Marlin (shape or device).")
+    )
+    return fits
+
+
+def scale_decode_for(scale_bytes: torch.Tensor) -> ScaleDecode:
+    """Pick the block-scale decode for a uint8 view of an E4M3 scale tensor."""
+    if (scale_bytes > 0x7E).any():
+        return ScaleDecode.UNSUPPORTED
+    if ((scale_bytes > 0) & (scale_bytes < 0x08)).any():
+        return ScaleDecode.EXACT
+    return ScaleDecode.FAST
+
+
+def _tile_row_order(num_rows: int, device: torch.device) -> torch.Tensor:
+    num_tiles = num_rows // _N_TILE_ROWS
+    tile = torch.arange(num_tiles, device=device).view(num_tiles, 1, 1)
+    slice_idx = torch.arange(8, device=device).view(1, 8, 1)
+    row = torch.arange(16, device=device).view(1, 1, 16)
+    half = num_rows // 2
+    return torch.where(
+        row < 8,
+        64 * tile + 8 * slice_idx + row,
+        half + 64 * tile + 8 * slice_idx + row - 8,
+    ).reshape(-1)
+
+
+def _code_lut(device: torch.device) -> torch.Tensor:
+    """int32 ``[8, 16]``: word bits of a code nibble for each slot of a word."""
+    lut = torch.zeros((8, 16), dtype=torch.int64, device=device)
+    for slot, positions in enumerate(_CODE_BIT_POSITIONS):
+        for code in range(16):
+            lut[slot, code] = sum(
+                ((code >> bit) & 1) << pos for bit, pos in enumerate(positions)
+            )
+    return lut.to(torch.int32)
+
+
+def grouped_fp4_weight_shape(weight: torch.Tensor) -> tuple[int, int, int, int]:
+    """Shape of the grouped layout for native NVFP4 ``[E, N, 2048]`` codes."""
+    num_experts, num_rows, _ = weight.shape
+    return (num_experts, num_rows // _N_TILE_ROWS, _K_STAGES, _K_STAGE_BYTES)
+
+
+def _release_cached_device_memory(device: torch.device) -> None:
+    """Return free allocator segments to the driver: a tensor carved from a freed repack temporary pins its segment past ``empty_cache`` (9.84 GiB per rank of KV pool)."""
+    if device.type == "cuda":
+        torch.cuda.empty_cache()
+
+
+def repack_fp4_weight_for_grouped_moe(
+    weight: torch.Tensor,
+    scale: torch.Tensor,
+    gated: bool,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """NVFP4 ``[E, N, 2048]`` codes and E4M3 scales -> uint8 ``[E, N / 128, 64, 4608]`` (into ``out`` if given): per (n-tile, k-stage) 4096 code bytes, then 512 scale bytes (convert8 in the .cuh)."""
+    num_experts, num_rows, _ = weight.shape
+    num_tiles = num_rows // _N_TILE_ROWS
+    device = weight.device
+    if out is None:
+        out = torch.empty(
+            grouped_fp4_weight_shape(weight), dtype=torch.uint8, device=device
+        )
+    elif out.shape != grouped_fp4_weight_shape(weight) or out.dtype != torch.uint8:
+        raise ValueError("out must be the uint8 grouped layout of weight")
+    scale_bytes = scale.view(torch.uint8)
+    if gated:
+        rows = _tile_row_order(num_rows, device)
+        weight = weight[:, rows]
+        scale_bytes = scale_bytes[:, rows]
+
+    codes = torch.stack((weight & 15, weight >> 4), dim=-1).flatten(-2)
+    zero_blocks = scale_bytes == 0
+    if zero_blocks.any():
+        codes[zero_blocks.repeat_interleave(_GROUP_SIZE, dim=-1)] = 0
+
+    codes = (
+        codes.view(num_experts, num_tiles, 2, 4, 2, 8, _K_STAGES, 4, 2, 4, 2)
+        .permute(0, 1, 6, 2, 3, 5, 9, 7, 4, 8, 10)
+        .reshape(num_experts, num_tiles, _K_STAGES, 2, 4, 8, 4, 4, 8)
+    )
+    lut = _code_lut(device)
+    words = out[..., :4096].view(torch.int32).view(codes.shape[:-1])
+    words.zero_()
+    for slot in range(8):
+        words |= lut[slot][codes[..., slot].long()]
+    del codes
+    out[..., 4096:] = (
+        scale_bytes.view(num_experts, num_tiles, 2, 4, 2, 8, _K_STAGES, 4)
+        .permute(0, 1, 6, 2, 3, 5, 7, 4)
+        .reshape(num_experts, num_tiles, _K_STAGES, 512)
+    )
+    return out
+
+
+def prepare_grouped_fp4_moe_weights(layer: torch.nn.Module) -> bool:
+    """Replace the native expert tensors with the grouped layout; False (natives kept) when the scale bytes need Marlin."""
+    gate_up_decode = scale_decode_for(layer.gate_up_proj_weight_scale.view(torch.uint8))
+    down_decode = scale_decode_for(layer.down_proj_weight_scale.view(torch.uint8))
+    decode = ScaleDecode(max(gate_up_decode, down_decode))
+    if decode is ScaleDecode.UNSUPPORTED:
+        print_warning_once(
+            "Muse NVFP4 experts: scale bytes outside E4M3 range; using Marlin."
+        )
+        return False
+    layer.grouped_fp4_fast_scale = decode is ScaleDecode.FAST
+    from sglang.kernels.ops.moe.muse_spark_fp4_grouped import (
+        prepare_muse_spark_fp4_grouped_kernel,
+    )
+
+    prepare_muse_spark_fp4_grouped_kernel(layer.grouped_fp4_fast_scale)
+
+    device = layer.gate_up_proj.device
+    # Column 0 only, as in the Marlin path; the post-expert RMSNorm cancels the
+    # gate/up gain mismatch. Rounded to bf16 like Marlin's global scale.
+    copy_or_rebind_param(
+        layer,
+        "grouped_gate_up_scale",
+        layer.gate_up_proj_weight_scale_2[:, 0].to(torch.bfloat16).to(torch.float32),
+    )
+    copy_or_rebind_param(
+        layer,
+        "grouped_down_scale",
+        layer.down_proj_weight_scale_2.to(torch.bfloat16).to(torch.float32),
+    )
+    _release_cached_device_memory(device)
+    copy_or_rebind_param(
+        layer,
+        "grouped_gate_up",
+        torch.empty(
+            grouped_fp4_weight_shape(layer.gate_up_proj),
+            dtype=torch.uint8,
+            device=device,
+        ),
+    )
+    copy_or_rebind_param(
+        layer,
+        "grouped_down",
+        torch.empty(
+            grouped_fp4_weight_shape(layer.down_proj),
+            dtype=torch.uint8,
+            device=device,
+        ),
+    )
+    repack_fp4_weight_for_grouped_moe(
+        layer.gate_up_proj,
+        layer.gate_up_proj_weight_scale,
+        gated=True,
+        out=layer.grouped_gate_up.data,
+    )
+    del layer._parameters["gate_up_proj"]
+    del layer._parameters["gate_up_proj_weight_scale"]
+    del layer._parameters["gate_up_proj_weight_scale_2"]
+    repack_fp4_weight_for_grouped_moe(
+        layer.down_proj,
+        layer.down_proj_weight_scale,
+        gated=False,
+        out=layer.grouped_down.data,
+    )
+    del layer._parameters["down_proj"]
+    del layer._parameters["down_proj_weight_scale"]
+    del layer._parameters["down_proj_weight_scale_2"]
+    _release_cached_device_memory(device)
+    return True
