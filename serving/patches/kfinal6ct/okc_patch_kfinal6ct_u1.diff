+      } else {
+        named_bar_sync(1, kCT);
+        for (int i = ctid; i < ntok * 16; i += 256) {
+          const int tl = i >> 4, c = i & 15;
+          if constexpr (kRows) {
+            const size_t r = row0 + half * 128 + tl;
