diff --git a/python/sglang/srt/speculative/dflash_prompt_lookup.py b/python/sglang/srt/speculative/dflash_prompt_lookup.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/srt/speculative/dflash_prompt_lookup.py
@@ -0,0 +1,210 @@
+"""Prompt-lookup drafts for DFLASH: copy a request's own earlier tokens into the draft block."""
+
+from collections import deque
+from typing import Dict, List, Optional
+
+import numpy as np
+import torch
+from numpy.lib.stride_tricks import sliding_window_view
+
+_POS_BITS = 24
+_POS_MASK = (1 << _POS_BITS) - 1
+_HASH_BASE = np.uint64(1000003)
+_MAX_KEY_CHUNKS = 16
+_NUM_RECENT_INDEXES = 64
+
+
+def _hash_ngrams(tokens: np.ndarray, ngram_size: int) -> np.ndarray:
+    windows = sliding_window_view(tokens, ngram_size).astype(np.uint64)
+    powers = _HASH_BASE ** np.arange(ngram_size, dtype=np.uint64)
+    return (windows * powers).sum(axis=1, dtype=np.uint64)
+
+
+def _sorted_prompt_keys(
+    prompt: np.ndarray, first_end: int, stop_end: int, ngram_size: int
+) -> np.ndarray:
+    hashes = _hash_ngrams(prompt[first_end - ngram_size + 1 : stop_end], ngram_size)
+    ends = np.arange(first_end, stop_end, dtype=np.uint64)
+    keys = (hashes << np.uint64(_POS_BITS)) | ends
+    keys.sort()
+    return keys
+
+
+class _RequestLookupIndex:
+    """N-gram index over one request's history, newest occurrence first."""
+
+    def __init__(
+        self,
+        prompt: np.ndarray,
+        ngram_size: int,
+        base: Optional["_RequestLookupIndex"] = None,
+    ):
+        self.ngram_size = ngram_size
+        self.prompt = prompt
+        self.num_tokens = len(prompt)
+        num_prompt = len(self.prompt)
+        first_end = ngram_size - 1
+        self._prompt_chunks: List[np.ndarray] = []
+        if base is not None:
+            self._prompt_chunks = list(base._prompt_chunks)
+            first_end = max(first_end, len(base.prompt) - 1)
+        if num_prompt > _POS_MASK:
+            self._prompt_chunks = []
+        elif num_prompt - 1 > first_end:
+            self._prompt_chunks.append(
+                _sorted_prompt_keys(prompt, first_end, num_prompt - 1, ngram_size)
+            )
+        if len(self._prompt_chunks) > _MAX_KEY_CHUNKS:
+            self._prompt_chunks = [np.sort(np.concatenate(self._prompt_chunks))]
+        self._generated: Dict[tuple, int] = {}
+        self._next_end = max(num_prompt - 1, ngram_size - 1)
+
+    def _slice(self, output: np.ndarray, lo: int, hi: int) -> np.ndarray:
+        num_prompt = len(self.prompt)
+        if hi <= num_prompt:
+            return self.prompt[lo:hi]
+        if lo >= num_prompt:
+            return output[lo - num_prompt : hi - num_prompt]
+        return np.concatenate([self.prompt[lo:], output[: hi - num_prompt]])
+
+    def _index_generated(self, output: np.ndarray, num_tokens: int) -> None:
+        last_end = num_tokens - 2
+        if self._next_end > last_end:
+            return
+        n = self.ngram_size
+        span = self._slice(output, self._next_end - n + 1, last_end + 1).tolist()
+        for end in range(self._next_end, last_end + 1):
+            offset = end - self._next_end
+            self._generated[tuple(span[offset : offset + n])] = end
+        self._next_end = last_end + 1
+
+    def _find_prompt(self, query: np.ndarray) -> Optional[int]:
+        key_hi = int(_hash_ngrams(query, self.ngram_size)[0]) << _POS_BITS
+        key_hi &= (1 << 64) - 1
+        n = self.ngram_size
+        for keys in reversed(self._prompt_chunks):
+            idx = int(np.searchsorted(keys, np.uint64(key_hi | _POS_MASK), "right"))
+            if idx == 0:
+                continue
+            key = int(keys[idx - 1])
+            if (key >> _POS_BITS) != (key_hi >> _POS_BITS):
+                continue
+            end = key & _POS_MASK
+            if np.array_equal(self.prompt[end - n + 1 : end + 1], query):
+                return end
+        return None
+
+    def propose(
+        self, output: np.ndarray, *, row_width: int, max_new_tokens: Optional[int]
+    ) -> Optional[np.ndarray]:
+        """Return ``[last known token, continuation...]`` clamped to the token budget."""
+        num_tokens = len(self.prompt) + len(output)
+        self.num_tokens = num_tokens
+        n = self.ngram_size
+        if num_tokens < n + 1:
+            return None
+        self._index_generated(output, num_tokens)
+        query = self._slice(output, num_tokens - n, num_tokens)
+        end = self._generated.get(tuple(query.tolist()))
+        if end is None:
+            end = self._find_prompt(query)
+        if end is None:
+            return None
+        row_len = min(row_width, num_tokens - end)
+        if max_new_tokens is not None:
+            row_len = min(row_len, 1 + max_new_tokens - len(output))
+        if row_len <= 1:
+            return None
+        row = np.empty((row_len,), dtype=np.int64)
+        row[0] = query[-1]
+        row[1:] = self._slice(output, end + 1, end + row_len)
+        return row
+
+
+class DFlashPromptLookup:
+    def __init__(self, *, block_size: int, ngram_size: int):
+        self.block_size = block_size
+        self.ngram_size = ngram_size
+        self.row_width = 2 * block_size
+        self._indexes: Dict[str, _RequestLookupIndex] = {}
+        self._recent: deque = deque(maxlen=_NUM_RECENT_INDEXES)
+
+    def _prefix_index(self, prompt: np.ndarray) -> Optional[_RequestLookupIndex]:
+        for index in reversed(self._recent):
+            k = len(index.prompt)
+            if (
+                k < len(prompt)
+                and index.prompt[k - 1] == prompt[k - 1]
+                and np.array_equal(index.prompt, prompt[:k])
+            ):
+                return index
+        return None
+
+    def _index_for(self, req, num_tokens: int) -> _RequestLookupIndex:
+        index = self._indexes.get(req.rid)
+        if (
+            index is None
+            or index.num_tokens > num_tokens
+            or len(index.prompt) != len(req.origin_input_ids)
+        ):
+            prompt = np.frombuffer(req.origin_input_ids, dtype=np.int64).copy()
+            index = _RequestLookupIndex(
+                prompt, self.ngram_size, base=self._prefix_index(prompt)
+            )
+            self._indexes[req.rid] = index
+            self._recent.append(index)
+        return index
+
+    def build_rows(
+        self, reqs: List, *, pin_memory: bool = False
+    ) -> Optional[torch.Tensor]:
+        """int64 ``[bs, row_width + 2]``: row tokens, absolute position of the first, valid length (0: no match); None when nothing matches."""
+        bs = len(reqs)
+        packed = torch.zeros(
+            (bs, self.row_width + 2), dtype=torch.int64, pin_memory=pin_memory
+        )
+        table = packed.numpy()
+        any_match = False
+        for i, req in enumerate(reqs):
+            output = np.frombuffer(req.output_ids, dtype=np.int64)
+            index = self._index_for(req, len(req.origin_input_ids) + len(output))
+            row = index.propose(
+                output,
+                row_width=self.row_width,
+                max_new_tokens=req.sampling_params.max_new_tokens,
+            )
+            if row is None or len(row) < self.block_size:
+                continue
+            table[i, : len(row)] = row
+            table[i, self.row_width] = len(index.prompt) + len(output) - 1
+            table[i, self.row_width + 1] = len(row)
+            any_match = True
+        if len(self._indexes) > 2 * bs + 16:
+            live = {req.rid for req in reqs}
+            self._indexes = {k: v for k, v in self._indexes.items() if k in live}
+        return packed if any_match else None
+
+
+def select_prompt_lookup_drafts(
+    *,
+    draft_next: torch.Tensor,
+    bonus_tokens: torch.Tensor,
+    prefix_lens: torch.Tensor,
+    packed_rows: torch.Tensor,
+) -> torch.Tensor:
+    """Per row, lookup drafts where the bonus (at absolute ``prefix_lens``) lands on the lookup path, else ``draft_next`` ``[bs, block_size - 1]``."""
+    num_drafts = draft_next.shape[1]
+    row_width = packed_rows.shape[1] - 2
+    rows = packed_rows[:, :row_width]
+    starts = packed_rows[:, row_width]
+    num_valid = packed_rows[:, row_width + 1]
+    offset = prefix_lens.to(torch.int64) - starts
+    in_range = (offset >= 0) & (offset + num_drafts < num_valid)
+    anchor_idx = offset.clamp(0, row_width - 1)
+    anchor = rows.gather(1, anchor_idx.unsqueeze(1)).squeeze(1)
+    use_lookup = in_range & (anchor == bonus_tokens.to(rows.dtype))
+    draft_idx = anchor_idx.unsqueeze(1) + torch.arange(
+        1, num_drafts + 1, device=rows.device
+    )
+    lookup = rows.gather(1, draft_idx.clamp(max=row_width - 1))
+    return torch.where(use_lookup.unsqueeze(1), lookup.to(draft_next.dtype), draft_next)
