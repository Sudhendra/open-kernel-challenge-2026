+  if (threadIdx.x == 0) {
+    *reinterpret_cast<volatile int*>(base + 240) = 0;
+    *reinterpret_cast<volatile int*>(base + 244) = 0;
+    *reinterpret_cast<volatile int*>(base + 248) = 0;
+    for (int s = 0; s < kSlots; ++s) {
+      mbar_init(bars + 8 * s, 1);
+      mbar_init(bars + 8 * kSlots + 8 * s, 128 * kWG);
