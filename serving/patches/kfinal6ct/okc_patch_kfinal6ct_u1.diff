diff --git a/python/sglang/kernels/ops/attention/muse_spark_verify_tree.py b/python/sglang/kernels/ops/attention/muse_spark_verify_tree.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/kernels/ops/attention/muse_spark_verify_tree.py
@@ -0,0 +1,135 @@
+"""Tree-masked target-verify attention for Muse Spark (16 q / 2 kv heads, head dim 64, FP8 KV, page size 1):
+``correct`` merges each verify row's <= 8 table keys (``build_tables``) with the prefix call's FP32 split
+partials (FA3's, or ``prefix_verify``'s own kernel).
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Optional
+
+import torch
+import triton
+import triton.language as tl
+
+from sglang.kernels.jit.utils import cache_once, is_arch_support_pdl, load_jit, make_cpp_args
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+ROWS = 8
+SLOTS = 8
+_LOG2E = 1.4426950408889634
+
+
+@cache_once
+def _module(pdl: bool) -> Module:
+    args = make_cpp_args(pdl)
+    return load_jit(
+        "muse_spark_verify_tree",
+        *args,
+        cuda_files=["muse_spark/verify_tree_attention.cuh"],
+        cuda_wrappers=[
+            ("correct", f"muse_spark_verify_tree::correct<{args}>"),
+            ("prefix", "muse_spark_verify_tree::prefix"),
+        ],
+        extra_cuda_cflags=["-O3", "--use_fast_math"],
+    )
+
+
+@triton.jit
+def _tables_kernel(seq_ptr, slot_ptr, pt_ptr, pt_stride, loc_ptr, out_ptr, window, SWA: tl.constexpr):
+    t = tl.program_id(0)
+    b, r = t // 8, t % 8
+    p = tl.load(seq_ptr + b)
+    e = tl.minimum(tl.maximum(tl.load(slot_ptr + b), 0), 3)
+    branch = (e > 0) & (r >= 6)
+    d = tl.where(branch, e + r - 6, r)
+    lo = tl.maximum(p + d - window, 0) * SWA
+    edge = (tl.maximum(p + r - window, 0) - lo) * SWA
+    k = tl.arange(0, 8)
+    see = tl.where(branch, (k < e) | (k == 6) | ((k == 7) & (r == 7)), k <= r)
+    rank = tl.cumsum(see.to(tl.int32), 0) - 1
+    hit = see[None, :] & (rank[None, :] == (k - edge)[:, None])
+    new = tl.sum(tl.where(hit, tl.load(loc_ptr + b * 8 + k)[None, :], 0), 1)
+    old = tl.load(pt_ptr + b * pt_stride + lo + k, mask=k < edge, other=0)
+    val = tl.where(k < edge, old, tl.where(tl.sum(hit.to(tl.int32), 1) > 0, new, -1))
+    tl.store(out_ptr + t * 8 + k, val.to(tl.int32))
+
+
+def build_tables(
+    *,
+    seq_lens: torch.Tensor,
+    branch_slot: torch.Tensor,
+    page_table: torch.Tensor,
+    out_cache_loc: torch.Tensor,
+    table: torch.Tensor,
+    window: int,
+    swa_page_table: Optional[torch.Tensor] = None,
+    swa_out_cache_loc: Optional[torch.Tensor] = None,
+    swa_table: Optional[torch.Tensor] = None,
+) -> None:
+    """Fill ``table`` / ``swa_table`` (int32 [8B, 8], -1 = empty) with each row's correction keys, for FA3 run
+    non-causal over the p old keys (sliding window (window - 8, 7)): a branch row's missing window left edge
+    (SWA only), then the new rows it may see."""
+    for pt, loc, out, swa in ((page_table, out_cache_loc, table, 0), (swa_page_table, swa_out_cache_loc, swa_table, 1)):
+        if pt is not None and seq_lens.shape[0]:
+            _tables_kernel[(seq_lens.shape[0] * ROWS,)](seq_lens, branch_slot, pt, pt.stride(0), loc, out, window, SWA=swa)
+
+
+def correct(
+    *,
+    q: torch.Tensor,
+    k_cache: torch.Tensor,
+    v_cache: torch.Tensor,
+    table: torch.Tensor,
+    out_partial: torch.Tensor,
+    lse_partial: torch.Tensor,
+    scheduler_metadata: torch.Tensor,
+    sorted_batches: bool,
+    out: torch.Tensor,
+    softmax_scale: float,
+    k_scale: float = 1.0,
+    v_scale: float = 1.0,
+) -> torch.Tensor:
+    """Merge each row's correction keys into the prefix call's split partials; writes bf16 ``out`` [8B, 16, 64] in place.
+
+    ``q`` e4m3 [8B, 16, 64] as FA3 read it; ``k_cache`` / ``v_cache`` the layer's e4m3 rows (any view with
+    2 x 64 contiguous values per slot); ``out_partial`` fp32 [S, 16, 8B, 64] / ``lse_partial`` fp32 [S, 16, 8B]
+    are the prefix call's partial outputs (FA3's extra outputs, or prefix_verify's); after FA3, every request's split count in ``scheduler_metadata`` must be >= 2."""
+    bs = q.shape[0] // ROWS
+    b_rounded = (bs + 3) // 4 * 4
+    kc = k_cache.view(torch.uint8).view(-1, 128)
+    vc = v_cache.view(torch.uint8).view(-1, 128)
+    _module(is_arch_support_pdl()).correct(
+        q.view(torch.uint8).view(-1, 16, 64),
+        kc,
+        vc,
+        table[: q.shape[0]],
+        out_partial,
+        lse_partial,
+        scheduler_metadata,
+        out.view(-1, 16, 64),
+        2 * b_rounded if sorted_batches else -1,
+        float(softmax_scale) * float(k_scale) * _LOG2E,
+        float(v_scale),
+    )
+    return out
+
+
+
+
+def prefix_verify(*, q, k_cache, v_cache, page_table, prefix_lens, table, out, softmax_scale, k_scale, v_scale, window=0):
+    """Tree verify without FA3 (page size 1): the prefix kernel's split partials over each request's p old keys (row r:
+    [p - 8 + r - window, p) as FA3's non-causal (window, 7) call), merged by ``correct``; writes bf16 ``out`` [8B, 16, 64]."""
+    bs = prefix_lens.shape[0]
+    splits = max(2, min(128, torch.cuda.get_device_properties(q.device).multi_processor_count // max(bs, 1)))
+    o = q.new_empty((splits, 16, 8 * bs, 64), dtype=torch.float32)
+    lse, sched = o.new_empty(o.shape[:3]), prefix_lens.new_empty(bs)
+    kc, vc = k_cache.view(torch.uint8).view(-1, 128), v_cache.view(torch.uint8).view(-1, 128)
+    _module(is_arch_support_pdl()).prefix(
+        q.view(torch.uint8).view(-1, 16, 64), kc, vc, page_table[:bs], prefix_lens, o, lse, sched, k_cache.shape[1], window,
+        float(softmax_scale) * float(k_scale) * _LOG2E, float(v_scale),
+    )
+    return correct(q=q, k_cache=k_cache, v_cache=v_cache, table=table, out_partial=o, lse_partial=lse,
+                   scheduler_metadata=sched, sorted_batches=False, out=out, softmax_scale=softmax_scale,
+                   k_scale=k_scale, v_scale=v_scale)
