+          case 16:
+            consumer_item<16, kFastScale, kSlots, kSlotBytes, 4>(p, ring, stg, bars, slot, ph, ti.x, ti.y, 2 * ntile, first, dn, pubq);
+            break;
+          case 32:
+            consumer_item<32, kFastScale, kSlots, kSlotBytes, 4>(p, ring, stg, bars, slot, ph, ti.x, ti.y, 2 * ntile, first, dn, pubq);
