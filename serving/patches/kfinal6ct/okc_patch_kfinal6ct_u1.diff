diff --git a/python/sglang/kernels/ops/gemm/muse_spark_router_mma.py b/python/sglang/kernels/ops/gemm/muse_spark_router_mma.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/kernels/ops/gemm/muse_spark_router_mma.py
@@ -0,0 +1,76 @@
+"""Full fp32 MuseSpark router logits in one launch on SM90 (csrc/muse_spark/router_mma.cuh).
+
+Same products as the unsharded router (bf16 hi + lo above 8 rows as ``forward_split2``,
+TF32 at or below as ``F.linear``); deterministic, fp32 summation order differs from cuBLAS.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+import torch
+
+from sglang.kernels.jit.utils import (
+    cache_once,
+    is_arch_support_pdl,
+    load_jit,
+    make_cpp_args,
+)
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+MAX_TOKENS = 64
+# At or below this many rows the router runs in TF32, above it as bf16 hi + lo.
+TF32_MAX_TOKENS = 8
+_TILES = (1, 2, 4, 8)
+_CONFIG = (8, 8)
+
+
+def _tiles_for(m: int) -> int:
+    return next(t for t in _TILES if 8 * t >= m)
+
+
+def router_mma_supported(x: torch.Tensor, w: torch.Tensor) -> bool:
+    """SM90, contiguous ``x [2 <= M <= 64, K]`` (bf16 above 8 rows, fp32 at or below), fp32 ``w``.
+    Reads no activation address: callers drop a collective on it, so ranks must agree."""
+    m = x.shape[0] if x.dim() == 2 else 0
+    return (
+        # cuBLAS runs a single fp32 row as an exact fp32 GEMV, not in TF32.
+        2 <= m <= MAX_TOKENS
+        and x.dtype == (torch.bfloat16 if m > TF32_MAX_TOKENS else torch.float32)
+        and (m > TF32_MAX_TOKENS or torch.get_float32_matmul_precision() != "highest")
+        and w.dtype == torch.float32
+        and w.dim() == 2
+        and x.shape[1] == w.shape[1]
+        and w.shape[0] % 16 == 0
+        and w.shape[1] % (8 * 8 * 32) == 0
+        and x.is_contiguous()
+        and w.is_contiguous()
+        and w.data_ptr() % 16 == 0
+        and x.is_cuda
+        and torch.cuda.get_device_capability(x.device)[0] == 9
+    )
+
+
+@cache_once
+def _jit_module(n: int, k: int, split_bf16: bool, tiles: int) -> Module:
+    args = make_cpp_args(n, k, split_bf16, *_CONFIG, tiles, is_arch_support_pdl())
+    return load_jit(
+        "muse_spark_router_mma",
+        *args,
+        cuda_files=["muse_spark/router_mma.cuh"],
+        cuda_wrappers=[("run", f"MuseSparkRouterMma<{args}>::run")],
+        extra_cuda_cflags=["-O3"],
+    )
+
+
+def router_mma(x: torch.Tensor, w: torch.Tensor) -> torch.Tensor:
+    """fp32 ``[M, E]`` logits; check ``router_mma_supported`` first."""
+    if x.data_ptr() % 16:
+        x = x.clone()
+    m = x.shape[0]
+    out = torch.empty((m, w.shape[0]), dtype=torch.float32, device=x.device)
+    module = _jit_module(w.shape[0], w.shape[1], m > TF32_MAX_TOKENS, _tiles_for(m))
+    module.run(x, w, out)
+    return out
diff --git a/python/sglang/kernels/ops/gemm/small_m_pdl_gemm.py b/python/sglang/kernels/ops/gemm/small_m_pdl_gemm.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/kernels/ops/gemm/small_m_pdl_gemm.py
@@ -0,0 +1,91 @@
+"""bf16 small-M GEMM (M <= 64) for decode / verify projections on SM90 (csrc/gemm/small_m_pdl_gemm.cuh).
+
+FP32 accumulation, one bf16 rounding; the fp32 summation order is fixed per launch config (picked by (N, K) and M range).
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Optional
+
+import torch
+
+from sglang.kernels.jit.utils import (
+    cache_once,
+    is_arch_support_pdl,
+    load_jit,
+    make_cpp_args,
+)
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+MAX_TOKENS = 64
+_TILES = (1, 2, 4, 8)
+
+
+def tiles_for(m: int) -> int:
+    return next(t for t in _TILES if 8 * t >= m)
+
+
+_TUNED = {
+    (2304, 8192): ((8, (1, 8, 1, 8, 1)), (16, (1, 8, 2, 4, 2))),
+    (8192, 1024): ((16, (1, 8, 1, 4, 2)),),
+    (512, 8192): ((32, (1, 8, 8, 8, 1)),),
+    (1024, 4096): ((32, (1, 8, 4, 8, 1)),),
+}
+
+
+_TUNED_32 = {
+    (2304, 8192): (1, 4, 4, 4, 1),
+    (8192, 1024): (1, 4, 1, 8, 2),
+    (512, 8192): (1, 8, 4, 8, 1),
+}
+
+
+def config_for(n: int, k: int, m: int) -> Optional[tuple[int, int, int, int, int]]:
+    """Launch shape for ``m`` rows of an ``[n, k]`` weight, or None to keep cuBLAS."""
+    if 16 < m <= 32 and (n, k) in _TUNED_32:
+        return _TUNED_32[(n, k)]
+    return next((cfg for max_m, cfg in _TUNED.get((n, k), ()) if m <= max_m), None)
+
+
+def small_m_pdl_gemm_supported(x: torch.Tensor, w: torch.Tensor) -> bool:
+    return (
+        x.dim() == 2
+        and x.dtype == torch.bfloat16
+        and w.dtype == torch.bfloat16
+        and 1 <= x.shape[0] <= MAX_TOKENS
+        and x.shape[1] == w.shape[1]
+        and x.is_contiguous()
+        and w.is_contiguous()
+        and x.data_ptr() % 16 == 0
+        and w.data_ptr() % 16 == 0
+        and torch.cuda.get_device_capability(x.device)[0] == 9
+        and config_for(w.shape[0], w.shape[1], x.shape[0]) is not None
+    )
+
+
+@cache_once
+def _jit_module(n: int, k: int, tiles: int, config: tuple[int, int, int, int, int]) -> Module:
+    args = make_cpp_args(n, k, *config[:3], tiles, *config[3:], is_arch_support_pdl())
+    return load_jit(
+        "small_m_pdl_gemm",
+        *args,
+        cuda_files=["gemm/small_m_pdl_gemm.cuh"],
+        cuda_wrappers=[("run", f"SmallMPdlGemm<{args}>::run")],
+        extra_cuda_cflags=["-O3"],
+    )
+
+
+def small_m_pdl_gemm(
+    x: torch.Tensor,
+    w: torch.Tensor,
+    out: Optional[torch.Tensor] = None,
+    config: Optional[tuple[int, int, int, int, int]] = None,
+) -> torch.Tensor:
+    """``x @ w.T`` for contiguous bf16 ``x [M <= 64, K]`` and ``w [N, K]``."""
+    (m, k), n = x.shape, w.shape[0]
+    if out is None:
+        out = x.new_empty((m, n))
+    _jit_module(n, k, tiles_for(m), config or config_for(n, k, m)).run(x, w, out)
+    return out
