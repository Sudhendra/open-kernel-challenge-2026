+"""Copy-engine pipelines for the collectives of the token-sharded prefill region.
+
+Rows live in symmetric memory and move per rank block on a side stream while the main
+stream runs the projection on the blocks already present: gather (qkv_proj per arrived
+block), scatter (o_proj per destination block, folded by the owner), replicated o_proj
+(the owner runs one fp32 o_proj on a full-weight copy, rounded once, where the scatter
+rounds each rank's bf16 partial), expert gather and expert scatter (the combine stores routed rows
+to their owner; a rank with no route to a row adds +0.0, as its combine would send).
+"""
+
+from __future__ import annotations
+
+from typing import Callable, List, Optional
+
+import torch
+
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _ring_fold_kernel(
+    slots_ptr,
+    out_ptr,
+    slot_stride,
+    numel,
+    owner,
+    WORLD: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    offs = tl.program_id(0).to(tl.int64) * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < numel
+    first = (owner + 1) % WORLD
+    acc = tl.load(slots_ptr + first * slot_stride + offs, mask=mask)
+    acc = acc.to(tl.float32)
+    for step in tl.static_range(2, WORLD + 1):
+        src = (owner + step) % WORLD
+        x = tl.load(slots_ptr + src * slot_stride + offs, mask=mask)
+        acc += x.to(tl.float32)
+    tl.store(out_ptr + offs, acc.to(tl.bfloat16), mask=mask)
+
+
+@triton.jit
+def _routed_ring_fold_kernel(
+    slots_ptr,
+    out_ptr,
+    ids_ptr,
+    slot_stride,
+    owner,
+    row0,
+    num_tokens,
+    experts_per_rank,
+    WORLD: tl.constexpr,
+    TOPK: tl.constexpr,
+    H: tl.constexpr,
+):
+    row = tl.program_id(0)
+    tok = row0 + row
+    offs = tl.arange(0, H)
+    ks = tl.arange(0, TOPK)
+    ids = tl.load(ids_ptr + tok.to(tl.int64) * TOPK + ks, mask=tok < num_tokens, other=-1)
+    src_of = tl.where(ids >= 0, ids // experts_per_rank, -1)
+    base = slots_ptr + row.to(tl.int64) * H + offs
+    acc = tl.zeros([H], dtype=tl.float32)
+    for step in tl.static_range(1, WORLD + 1):
+        src = (owner + step) % WORLD
+        routed = tl.sum((src_of == src).to(tl.int32), axis=0) > 0
+        # A rank with no route to the row would have sent +0.0.
+        x = tl.load(base + src.to(tl.int64) * slot_stride, mask=routed & (offs < H), other=0.0)
+        if step == 1:
+            acc = x.to(tl.float32)
+        else:
+            acc += x.to(tl.float32)
+    tl.store(out_ptr + row.to(tl.int64) * H + offs, acc.to(tl.bfloat16))
+
+
+@triton.jit
+def _pair_fold_kernel(
+    pairs_ptr, ids_ptr, w_ptr, norm_w_ptr, out_ptr, eps, row0, num_tokens,
+    TOPK: tl.constexpr, H: tl.constexpr, WEIGHT_FIRST: tl.constexpr,
+):
+    row = tl.program_id(0)
+    tok = (row0 + row).to(tl.int64)
+    valid = tok < num_tokens
+    offs = tl.arange(0, H)
+    nw = tl.load(norm_w_ptr + offs).to(tl.float32)
+    base = pairs_ptr + row.to(tl.int64) * TOPK * H
+    acc = tl.zeros([H], dtype=tl.float32)
+    for k in tl.static_range(TOPK):
+        e = tl.load(ids_ptr + tok * TOPK + k, mask=valid, other=-1)
+        if e >= 0:
+            x = tl.load(base + k * H + offs).to(tl.float32)
+            if WEIGHT_FIRST:
+                y = x * nw
+                var = tl.sum(y * y, axis=0) / H
+                y = y * tl.rsqrt(var + eps)
+            else:
+                var = tl.sum(x * x, axis=0) / H
+                y = x * tl.rsqrt(var + eps) * nw
+            acc += y * tl.load(w_ptr + tok * TOPK + k)
+    tl.store(out_ptr + row.to(tl.int64) * H + offs, acc.to(tl.bfloat16))
+
+
+@triton.jit
+def _store_routes_kernel(
+    scores_ptr, ids_ptr, bases_ptr, scores_at, ids_at, numel, WORLD: tl.constexpr, BLOCK: tl.constexpr
+):
+    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < numel
+    scores = tl.load(scores_ptr + offs, mask=mask)
+    ids = tl.load(ids_ptr + offs, mask=mask).to(tl.int32)
+    for dest in tl.static_range(WORLD):
+        base = tl.load(bases_ptr + dest).to(tl.pointer_type(tl.int32))
+        tl.store(base + scores_at + offs, scores, mask=mask)
+        tl.store(base + ids_at + offs, ids, mask=mask)
+
+
+@triton.jit
+def _push_routed_rows_kernel(
+    rows_ptr, ids_ptr, bases_ptr, row0, slot_row0, rank, experts_per_rank,
+    WORLD: tl.constexpr, TOPK: tl.constexpr, H: tl.constexpr,
+):
+    row = row0 + tl.program_id(0)
+    offs = tl.arange(0, H)
+    ids = tl.load(ids_ptr + row * TOPK + tl.arange(0, TOPK))
+    owner = tl.where(ids >= 0, ids // experts_per_rank, -1)
+    x = tl.load(rows_ptr + row.to(tl.int64) * H + offs)
+    at = (slot_row0 + row).to(tl.int64) * H + offs
+    for step in tl.static_range(1, WORLD):
+        dest = (rank + step) % WORLD
+        if tl.sum((owner == dest).to(tl.int32), axis=0) > 0:
+            tl.store(tl.load(bases_ptr + dest).to(tl.pointer_type(tl.bfloat16)) + at, x)
+
+
+MatmulInto = Callable[[torch.Tensor, torch.Tensor], None]
+
+
+def routed_ring_fold(
+    slots: torch.Tensor,
+    topk_ids: torch.Tensor,
+    *,
+    owner: int,
+    row0: int,
+    experts_per_rank: int,
+) -> torch.Tensor:
+    """``ring_fold`` of ``slots[:, r]`` for rows ``row0 + r``, reading only routed slots.
+
+    ``topk_ids`` covers the real tokens; rows past it are padding and sum to +0.0.
+    """
+    world, rows, width = slots.shape
+    num_tokens = topk_ids.shape[0]
+    if slots.is_cuda and slots.dtype == torch.bfloat16:
+        out = torch.empty((rows, width), dtype=slots.dtype, device=slots.device)
+        _routed_ring_fold_kernel[(rows,)](
+            slots,
+            out,
+            topk_ids,
+            slots.stride(0),
+            owner,
+            row0,
+            num_tokens,
+            experts_per_rank,
+            WORLD=world,
+            TOPK=topk_ids.shape[1],
+            H=width,
+            num_warps=8,
+        )
+        return out
+    raise TypeError("CUDA bf16 fold required")
+
+
+def pair_fold(
+    pairs: torch.Tensor,
+    topk_ids: torch.Tensor,
+    topk_scores: torch.Tensor,
+    *,
+    norm: tuple[torch.Tensor, float, bool],
+    row0: int,
+) -> torch.Tensor:
+    """The summed expert output of token ``row0 + r`` from its un-normed pair rows ``pairs[r, k]``:
+    the post-normed, score-weighted routes summed in k order in fp32, rounded to bf16 once."""
+    rows, top_k, width = pairs.shape
+    num_tokens = topk_ids.shape[0]
+    norm_weight, eps, weight_first = norm
+    if pairs.is_cuda:
+        out = torch.empty((rows, width), dtype=pairs.dtype, device=pairs.device)
+        _pair_fold_kernel[(rows,)](
+            pairs, topk_ids, topk_scores, norm_weight, out, eps, row0, num_tokens,
+            TOPK=top_k, H=width, WEIGHT_FIRST=weight_first, num_warps=8,
+        )
+        return out
+    raise TypeError("CUDA fold required")
+
+
+def ring_fold(slots: torch.Tensor, owner: int) -> torch.Tensor:
+    """Sum ``slots[r]`` over ranks from owner + 1 around to the owner in fp32, rounded once."""
+    world = slots.shape[0]
+    if slots.is_cuda and slots.dtype == torch.bfloat16:
+        out = torch.empty(slots.shape[1:], dtype=slots.dtype, device=slots.device)
+        numel = out.numel()
+        block = 2048
+        _ring_fold_kernel[(triton.cdiv(numel, block),)](
+            slots,
+            out,
+            slots.stride(0),
+            numel,
+            owner,
+            WORLD=world,
+            BLOCK=block,
+        )
+        return out
+    raise TypeError("CUDA bf16 fold required")
+
+
+class SymmetricRowSlots:
+    """``[num_slots, capacity, width]`` rows in symmetric memory and every rank's view."""
+
+    def __init__(self, *, local: torch.Tensor, peers: List[torch.Tensor], handle):
+        self.local = local
+        self.peers = peers
+        self.handle = handle
+
+    @property
+    def capacity(self) -> int:
+        return self.local.shape[1]
+
+    @property
+    def width(self) -> int:
+        return self.local.shape[2]
+
+    @classmethod
+    def allocate(
+        cls,
+        *,
+        group,
+        num_slots: int,
+        capacity: int,
+        width: int,
+        dtype: torch.dtype,
+        device: torch.device,
+    ) -> "SymmetricRowSlots":
+        """Collective over ``group``; call on every rank, outside graph capture."""
+        from torch._C._distributed_c10d import _SymmetricMemory
+
+        group_name = group.cpu_group.group_name
+        if torch.__version__ < "2.11.0":
+            import torch.distributed._symmetric_memory as torch_symm_mem
+
+            torch_symm_mem.enable_symm_mem_for_group(group_name)
+        shape = (num_slots, capacity, width)
+        buf = _SymmetricMemory.empty_strided_p2p(
+            (num_slots * capacity * width,), [1], dtype, device, group_name
+        )
+        handle = _SymmetricMemory.rendezvous(buf)
+        peers = [
+            handle.get_buffer(peer, shape, dtype, 0)
+            for peer in range(group.world_size)
+        ]
+        handle.barrier(channel=0)
+        return cls(local=buf.view(shape), peers=peers, handle=handle)
+
+
+class SpPrefillOverlap:
+    """The two attention pipelines of one model; slots per rank: world + 1."""
+
+    def __init__(
+        self,
+        *,
+        rank: int,
+        world_size: int,
+        slots: SymmetricRowSlots,
+        copy_stream: Optional[torch.cuda.Stream],
+    ):
+        self.rank = rank
+        self.world_size = world_size
+        self.slots = slots
+        self.stage_slot = world_size
+        self.copy_stream = copy_stream
+
+    def fits(self, rows: int, width: int) -> bool:
+        return rows <= self.slots.capacity and width == self.slots.width
+
+    def gather_matmul(
+        self, shard: torch.Tensor, matmul_into: MatmulInto, *, out_cols: int
+    ) -> torch.Tensor:
+        """``matmul(all_gather(shard))`` as ``[world * rows, out_cols]``, rank-major."""
+        rows = shard.shape[0]
+        self.slots.local[self.stage_slot, :rows].copy_(shard)
+        self.slots.handle.barrier(channel=0)
+        gathered = shard.new_empty((self.world_size * rows, shard.shape[1]))
+        out = shard.new_empty((self.world_size * rows, out_cols))
+        sources = [
+            (self.rank + step) % self.world_size for step in range(1, self.world_size)
+        ]
+        events = self._pull(
+            [
+                (
+                    gathered[src * rows : (src + 1) * rows],
+                    self.slots.peers[src][self.stage_slot, :rows],
+                )
+                for src in sources
+            ]
+        )
+        matmul_into(shard, out[self.rank * rows : (self.rank + 1) * rows])
+        for src, event in zip(sources, events):
+            if event is not None:
+                torch.cuda.current_stream().wait_event(event)
+            block = slice(src * rows, (src + 1) * rows)
+            matmul_into(gathered[block], out[block])
+        return out
+
+    def matmul_reduce_scatter(
+        self, x: torch.Tensor, matmul_into: MatmulInto, *, out_cols: int
+    ) -> torch.Tensor:
+        """This rank's ``[rows, out_cols]`` block of ``sum over ranks of matmul(x)``; ``x`` holds ``world * rows`` rows, rank-major."""
+        rows = x.shape[0] // self.world_size
+        partial = x.new_empty((x.shape[0], out_cols))
+        recv = self.slots.local[: self.world_size, :rows]
+        for step in range(1, self.world_size):
+            dest = (self.rank + step) % self.world_size
+            block = slice(dest * rows, (dest + 1) * rows)
+            matmul_into(x[block], partial[block])
+            dst = self.slots.peers[dest][self.rank, :rows]
+            _copy_on(self.copy_stream, [(dst, partial[block])])
+        own = slice(self.rank * rows, (self.rank + 1) * rows)
+        matmul_into(x[own], recv[self.rank])
+        if self.copy_stream is not None:
+            torch.cuda.current_stream().wait_stream(self.copy_stream)
+        self.slots.handle.barrier(channel=0)
+        return ring_fold(recv, self.rank)
+
+    def fits_push(self, rows: int, cols: int) -> bool:
+        return rows <= self.slots.capacity and cols <= self.slots.width
+
+    def push_matmul(
+        self, x: torch.Tensor, matmul_into: MatmulInto, *, out_cols: int
+    ) -> torch.Tensor:
+        """This rank's ``[rows, out_cols]`` block of ``matmul`` over every rank's ``x`` side by side: ``x`` is this rank's columns of ``world * rows`` rows, ``matmul_into`` takes ``[rows, world * cols]``."""
+        rows, cols = x.shape[0] // self.world_size, x.shape[1]
+
+        def blocks(buf: torch.Tensor) -> torch.Tensor:
+            return _packed(buf, self.world_size, rows, cols)
+
+        _copy_on(
+            self.copy_stream,
+            [
+                (blocks(self.slots.peers[d])[self.rank], x[d * rows : (d + 1) * rows])
+                for d in ((self.rank + s) % self.world_size for s in range(1, self.world_size))
+            ],
+        )
+        recv = blocks(self.slots.local)
+        recv[self.rank].copy_(x[self.rank * rows : (self.rank + 1) * rows])
+        if self.copy_stream is not None:
+            torch.cuda.current_stream().wait_stream(self.copy_stream)
+        self.slots.handle.barrier(channel=0)
+        out = x.new_empty((rows, out_cols))
+        matmul_into(recv.transpose(0, 1).reshape(rows, self.world_size * cols), out)
+        return out
+
+    def _pull(self, copies) -> List[Optional[torch.cuda.Event]]:
+        if self.copy_stream is None:
+            for dst, src in copies:
+                dst.copy_(src)
+            return [None] * len(copies)
+        self.copy_stream.wait_stream(torch.cuda.current_stream())
+        events = []
+        with torch.cuda.stream(self.copy_stream):
+            for dst, src in copies:
+                dst.copy_(src)
+                event = torch.cuda.Event()
+                event.record(self.copy_stream)
+                events.append(event)
+        return events
+
+
+def _packed(buf: torch.Tensor, slots: int, rows: int, width: int) -> torch.Tensor:
+    """``[slots, rows, width]`` packed from the start of ``buf``; every rank computes the same layout."""
+    return buf.view(-1)[: slots * rows * width].view(slots, rows, width)
+
+
+class SpExpertOverlap:
+    """The expert-row gather and the routed scatter of one model; ``routes`` holds the top-k scores (as int32 bits) and ids."""
+
+    def __init__(
+        self,
+        *,
+        rank: int,
+        world_size: int,
+        capacity: int,
+        width: int,
+        experts_per_rank: int,
+        rows: Optional[SymmetricRowSlots],
+        routes: Optional[SymmetricRowSlots],
+        scatter: Optional[SymmetricRowSlots],
+        gather_blocks: int,
+        copy_stream: Optional[torch.cuda.Stream],
+        sparse_push: bool = False,
+        pair_push: bool = False,
+    ):
+        self.rank = rank
+        self.world_size = world_size
+        self.capacity = capacity
+        self.width = width
+        self.experts_per_rank = experts_per_rank
+        self.row_slots = rows
+        self.route_slots = routes
+        self.scatter_slots = scatter
+        self.gather = rows is not None and routes is not None
+        self.scatter = scatter is not None
+        self.gather_blocks = max(1, gather_blocks)
+        self.copy_stream = copy_stream
+        self.sparse_push = sparse_push
+        self.pair_push = pair_push
+        self.scatter_bases = _bases(scatter) if scatter is not None else None
+        self.route_bases = _bases(routes) if self.gather else None
+        self.row_bases = _bases(rows) if self.gather else None
+        self._ordered_peers = [
+            (rank + step) % world_size for step in range(1, world_size)
+        ]
+
+    def fits(self, rows: int, width: int) -> bool:
+        return rows <= self.capacity and width == self.width
+
+    def _block_bounds(self, rows: int) -> List[tuple]:
+        blocks = min(self.gather_blocks, rows)
+        cuts = [rows * b // blocks for b in range(blocks + 1)]
+        return [(lo, hi) for lo, hi in zip(cuts, cuts[1:]) if hi > lo]
+
+    def _sparse_row0(self, rows: int) -> int:
+        """First row of the blocks left to ``push_routed_rows``: the copy engine is still busy with the first half when the routes arrive."""
+        bounds = self._block_bounds(rows)
+        return bounds[len(bounds) // 2][0]
+
+    def project_and_push(
+        self, shard: torch.Tensor, matmul_into: MatmulInto, *, sparse: bool = False
+    ) -> None:
+        """``matmul(shard)`` into this rank's gathered slot, each block pushed to every peer; with ``sparse`` only the blocks before ``_sparse_row0``."""
+        rows = shard.shape[0]
+        dense_end = self._sparse_row0(rows) if sparse else rows
+        own = _packed(self.row_slots.local, self.world_size, rows, self.width)[self.rank]
+        peers = [
+            _packed(self.row_slots.peers[d], self.world_size, rows, self.width)[self.rank]
+            for d in self._ordered_peers
+        ]
+        for lo, hi in self._block_bounds(rows):
+            matmul_into(shard[lo:hi], own[lo:hi])
+            if hi <= dense_end:
+                _copy_on(
+                    self.copy_stream, [(peer[lo:hi], own[lo:hi]) for peer in peers]
+                )
+
+    def push_routed_rows(self, topk_ids: torch.Tensor, *, rows: int) -> None:
+        """SM stores of this rank's rows from ``_sparse_row0`` to the peers holding one of their experts, at the dense slot rows; a peer's expert gather reads only rows routed to it."""
+        lo = self._sparse_row0(rows)
+        own = _packed(self.row_slots.local, self.world_size, rows, self.width)[self.rank]
+        _push_routed_rows_kernel[(rows - lo,)](
+            own,
+            topk_ids.contiguous(),
+            self.row_bases,
+            lo,
+            self.rank * rows,
+            self.rank,
+            self.experts_per_rank,
+            WORLD=self.world_size,
+            TOPK=topk_ids.shape[1],
+            H=self.width,
+            num_warps=8,
+        )
+
+    def push_routes(self, topk_scores: torch.Tensor, topk_ids: torch.Tensor) -> None:
+        """Store this rank's int32 scores and ids into its route slot on every rank."""
+        self._store_routes(topk_scores.float().contiguous().view(torch.int32), topk_ids.contiguous())
+
+    def _store_routes(self, scores: torch.Tensor, ids: torch.Tensor) -> None:
+        """int32 ``[rows, k]`` scores and ids into this rank's slot of both halves on every rank."""
+        numel, world = ids.numel(), self.world_size
+        at = (self.rank * numel, (world + self.rank) * numel)
+        block = 1024
+        _store_routes_kernel[(triton.cdiv(numel, block),)](
+            scores, ids, self.route_bases, *at, numel, WORLD=world, BLOCK=block
+        )
+
+    def finish_gather(
+        self, *, rows: int, top_k: int, num_tokens: int
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        """Every rank's expert rows, fp32 scores and int32 ids, ``[num_tokens, ...]``."""
+        self._join(self.copy_stream)
+        self.row_slots.handle.barrier(channel=0)
+        gathered = _packed(self.row_slots.local, self.world_size, rows, self.width)
+        gathered = gathered.view(self.world_size * rows, self.width)[:num_tokens]
+        halves = _packed(self.route_slots.local, 2, self.world_size * rows, top_k)
+        return gathered, halves[0, :num_tokens].view(torch.float32), halves[1, :num_tokens]
+
+    def scatter_target(self, rows: int) -> tuple[torch.Tensor, int, int]:
+        """(owner base addresses, this rank's first slot row, rows per owner) for the combine."""
+        return self.scatter_bases, self.rank * rows, rows
+
+    def stores_pairs(self, rows: int, top_k: int) -> bool:
+        """Pair rows ``[rows, top_k, width]`` fit the scatter slots' extent (the stage slot lies past it)."""
+        extent = self.scatter_slots.local[: self.world_size].numel() if self.scatter else 0
+        return self.pair_push and rows * top_k * self.width <= extent
+
+    def pair_target(self, rows: int) -> tuple[torch.Tensor, None, int]:
+        return self.scatter_bases, None, rows
+
+    def fold_pairs(
+        self,
+        topk_ids: torch.Tensor,
+        topk_scores: torch.Tensor,
+        *,
+        rows: int,
+        norm: tuple[torch.Tensor, float, bool],
+    ) -> torch.Tensor:
+        """``fold_scatter`` of the pair rows the expert kernels stored here."""
+        self.scatter_slots.handle.barrier(channel=0)
+        top_k = topk_ids.shape[1]
+        pairs = self.scatter_slots.local.view(-1)[: rows * top_k * self.width]
+        return pair_fold(
+            pairs.view(rows, top_k, self.width),
+            topk_ids,
+            topk_scores,
+            norm=norm,
+            row0=self.rank * rows,
+        )
+
+    def fold_scatter(self, topk_ids: torch.Tensor, *, rows: int) -> torch.Tensor:
+        """This rank's ``[rows, width]`` of the summed expert output, in ring order."""
+        self.scatter_slots.handle.barrier(channel=0)
+        slots = _packed(self.scatter_slots.local, self.world_size, rows, self.width)
+        return routed_ring_fold(
+            slots,
+            topk_ids,
+            owner=self.rank,
+            row0=self.rank * rows,
+            experts_per_rank=self.experts_per_rank,
+        )
+
+    @staticmethod
+    def _join(*streams: Optional[torch.cuda.Stream]) -> None:
+        for stream in streams:
+            if stream is not None:
+                torch.cuda.current_stream().wait_stream(stream)
+
+
+def _bases(slots: SymmetricRowSlots) -> torch.Tensor:
+    """int64 base address of every rank's slots, for kernels that store to peers."""
+    return torch.tensor([p.data_ptr() for p in slots.peers], dtype=torch.int64, device=slots.local.device)
+
+
+def _copy_on(stream: Optional[torch.cuda.Stream], copies) -> None:
+    """``dst.copy_(src)`` for each pair on ``stream`` after the current stream's work."""
+    if stream is None:
+        for dst, src in copies:
+            dst.copy_(src)
+        return
+    stream.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(stream):
+        for dst, src in copies:
+            dst.copy_(src)
diff --git a/python/sglang/srt/layers/muse_spark/muse_spark_sp_prefill.py b/python/sglang/srt/layers/muse_spark/muse_spark_sp_prefill.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/muse_spark_sp_prefill.py
@@ -0,0 +1,226 @@
+"""Token-sharded prefill region for Muse Spark under TP = EP."""
+
+from __future__ import annotations
+
+from typing import List, Optional
+
+import torch
+
+from sglang.srt.layers.muse_spark.muse_spark_sp_overlap import (
+    MatmulInto,
+    SpExpertOverlap,
+    SpPrefillOverlap,
+)
+from sglang.srt.utils.common import ceil_align
+
+
+def sp_prefill_enabled(*, tp_size: int, ep_size: int, moe_tp_size: int) -> bool:
+    """Static gate: TP = EP > 1 with whole experts per rank."""
+    return tp_size > 1 and tp_size == ep_size and moe_tp_size == 1
+
+
+class MuseSparkSpPrefill:
+    """Per-forward state and collectives of the region; one per model."""
+
+    def __init__(
+        self,
+        tp_group,
+        *,
+        # Stock all-reduces these [M, 4096] bf16 partials with the custom all-reduce (fp32, one rounding) up to its 16 MiB default cap
+        # (2048 rows), NCCL above; the region starts one row past it, as its NCCL reduce-scatter (layers without the expert push) rounds at each hop.
+        min_tokens: int = 2049,
+    ):
+        self.tp_group = tp_group
+        self.world_size: int = tp_group.world_size
+        self.rank: int = tp_group.rank_in_group
+        self.min_tokens = min_tokens
+        self.grouped_gather = tp_group.pynccl_comm is not None
+        self.active = False
+        self.num_tokens = 0
+        self.padded_tokens = 0
+        self.overlap: Optional[SpPrefillOverlap] = None
+        self.expert_overlap: Optional[SpExpertOverlap] = None
+
+    def runs(self, forward_mode, num_tokens: int) -> bool:
+        from sglang.srt.model_executor.forward_batch_info import ForwardMode
+
+        return (
+            forward_mode == ForwardMode.EXTEND
+            and num_tokens >= self.min_tokens
+            and self.world_size > 1
+        )
+
+    def enter(self, hidden_states: torch.Tensor) -> torch.Tensor:
+        """Keep this rank's token shard of the replicated [M, h] input."""
+        num_tokens = hidden_states.shape[0]
+        self.num_tokens = num_tokens
+        self.padded_tokens = ceil_align(num_tokens, self.world_size)
+        self.active = True
+        hidden_states = self._pad_rows(hidden_states)
+        shard = self.padded_tokens // self.world_size
+        return hidden_states.narrow(0, self.rank * shard, shard).contiguous()
+
+    def leave(
+        self,
+        hidden_states: torch.Tensor,
+        aux_hidden_states: List[torch.Tensor],
+        *,
+        gather_hidden: bool = True,
+    ) -> tuple[torch.Tensor, List[torch.Tensor]]:
+        """All-gather the shards back to [M, h] and close the region."""
+        if gather_hidden:
+            hidden_states = self.gather_rows(hidden_states)
+        aux_hidden_states = [self.gather_rows(t) for t in aux_hidden_states]
+        self.active = False
+        return hidden_states, aux_hidden_states
+
+    def _pad_rows(self, x: torch.Tensor) -> torch.Tensor:
+        pad = self.padded_tokens - x.shape[0]
+        if pad == 0:
+            return x
+        return torch.nn.functional.pad(x, (0, 0, 0, pad))
+
+    def gather_rows(self, shard: torch.Tensor) -> torch.Tensor:
+        """[Ms, ...] on every rank -> the full [M, ...] (padding rows dropped)."""
+        shard = shard.contiguous()
+        full = shard.new_empty((shard.shape[0] * self.world_size, *shard.shape[1:]))
+        self.tp_group.all_gather_into_tensor(full, shard)
+        return full[: self.num_tokens]
+
+    def gather_expert_rows(
+        self,
+        expert_input: torch.Tensor,
+        topk_scores: torch.Tensor,
+        topk_ids: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        """The expert runners take every token's input and routes, as in stock."""
+        if self.grouped_gather:
+            gathered = self.tp_group.all_gatherv(
+                [t.contiguous() for t in (expert_input, topk_scores, topk_ids)]
+            )
+            return tuple(t[: self.num_tokens] for t in gathered)
+        return (
+            self.gather_rows(expert_input),
+            self.gather_rows(topk_scores),
+            self.gather_rows(topk_ids),
+        )
+
+    def overlaps_gather(self, shard: torch.Tensor) -> bool:
+        return (
+            self.overlap is not None
+            and self.overlap.fits(shard.shape[0], shard.shape[1])
+        )
+
+    def overlaps_scatter(self, out_cols: int) -> bool:
+        return (
+            self.overlap is not None
+            and self.overlap.fits(self.padded_tokens // self.world_size, out_cols)
+        )
+
+    def gather_rows_matmul(
+        self, shard: torch.Tensor, matmul_into: MatmulInto, *, out_cols: int
+    ) -> torch.Tensor:
+        """``matmul(gather_rows(shard))``, each source block multiplied once it arrives."""
+        out = self.overlap.gather_matmul(
+            shard.contiguous(), matmul_into, out_cols=out_cols
+        )
+        return out[: self.num_tokens]
+
+    def matmul_reduce_scatter_rows(
+        self, x: torch.Tensor, matmul_into: MatmulInto, *, out_cols: int
+    ) -> torch.Tensor:
+        """``reduce_scatter_rows(matmul(x))``, each owner block pushed once computed."""
+        return self.overlap.matmul_reduce_scatter(
+            self._pad_rows(x.contiguous()), matmul_into, out_cols=out_cols
+        )
+
+    def pushes_rows(self, cols: int) -> bool:
+        """``push_rows_matmul`` can take ``[M, cols]`` inputs."""
+        return (
+            self.overlap is not None
+            and self.overlap.fits_push(self.padded_tokens // self.world_size, cols)
+        )
+
+    def push_rows_matmul(
+        self, x: torch.Tensor, matmul_into: MatmulInto, *, out_cols: int
+    ) -> torch.Tensor:
+        """``reduce_scatter_rows`` of the row-parallel matmul of ``x``, run on this rank's rows of every rank's ``x``."""
+        return self.overlap.push_matmul(
+            self._pad_rows(x.contiguous()), matmul_into, out_cols=out_cols
+        )
+
+    def reduce_scatter_rows(self, partial: torch.Tensor) -> torch.Tensor:
+        """Sum the per-rank [M, ...] partials; keep this rank's [Ms, ...] rows."""
+        partial = self._pad_rows(partial.contiguous())
+        shard = self.padded_tokens // self.world_size
+        output = partial.new_empty((shard, *partial.shape[1:]))
+        self.tp_group.reduce_scatter_tensor(output, partial)
+        return output
+
+    @property
+    def _shard_rows(self) -> int:
+        return self.padded_tokens // self.world_size
+
+    def gathers_expert_rows(self, width: int) -> bool:
+        overlap = self.expert_overlap
+        return (
+            overlap is not None
+            and overlap.gather
+            and overlap.fits(self._shard_rows, width)
+        )
+
+    def project_expert_rows(
+        self, shard: torch.Tensor, matmul_into: MatmulInto, *, routed_only: bool = False
+    ) -> bool:
+        """First half of ``gather_expert_rows``: project and push this rank's rows."""
+        sparse = routed_only and self.expert_overlap.sparse_push
+        self.expert_overlap.project_and_push(shard.contiguous(), matmul_into, sparse=sparse)
+        return sparse
+
+    def push_routed_expert_rows(self, topk_ids: torch.Tensor) -> None:
+        self.expert_overlap.push_routed_rows(topk_ids, rows=self._shard_rows)
+
+    def push_expert_routes(self, topk_scores: torch.Tensor, topk_ids: torch.Tensor) -> None:
+        self.expert_overlap.push_routes(topk_scores, topk_ids)
+
+    def finish_expert_gather(
+        self, *, top_k: int
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        """What ``gather_expert_rows`` returns, from the pushed rows and routes."""
+        return self.expert_overlap.finish_gather(
+            rows=self._shard_rows, top_k=top_k, num_tokens=self.num_tokens
+        )
+
+    def pushes_expert_rows(self, width: int) -> bool:
+        overlap = self.expert_overlap
+        return (
+            overlap is not None
+            and overlap.scatter
+            and overlap.fits(self._shard_rows, width)
+        )
+
+    def expert_scatter_target(self) -> tuple[torch.Tensor, int, int]:
+        return self.expert_overlap.scatter_target(self._shard_rows)
+
+    def stores_expert_pairs(self, top_k: int) -> bool:
+        return self.expert_overlap.stores_pairs(self._shard_rows, top_k)
+
+    def expert_pair_target(self) -> tuple[torch.Tensor, None, int]:
+        return self.expert_overlap.pair_target(self._shard_rows)
+
+    def fold_expert_pairs(
+        self, topk_ids: torch.Tensor, topk_scores: torch.Tensor, norm: tuple[torch.Tensor, float, bool]
+    ) -> torch.Tensor:
+        """``fold_expert_rows`` from the pair rows the expert kernels stored here."""
+        return self.expert_overlap.fold_pairs(
+            topk_ids.to(torch.int32).contiguous(),
+            topk_scores.to(torch.float32).contiguous(),
+            rows=self._shard_rows,
+            norm=norm,
+        )
+
+    def fold_expert_rows(self, topk_ids: torch.Tensor) -> torch.Tensor:
+        """``reduce_scatter_rows`` of the expert output whose routed rows were stored here."""
+        return self.expert_overlap.fold_scatter(
+            topk_ids.to(torch.int32).contiguous(), rows=self._shard_rows
+        )
