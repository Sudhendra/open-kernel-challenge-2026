+SGL_DEVICE void
+plan_warp(const int* __restrict__ counts, int4* __restrict__ tiles, int* __restrict__ ntiles, int fine, int e) {
+  const int c = counts[e];
+  const int full = c >> 8, r = c & 255;
+  int nr, nb;  // remainder tile widths (nb: second remainder tile or 0)
+  rem_tiles(r, fine, nr, nb);
+  const int rows = full * 256 + nr + nb;
+  const int nt = full + (nr > 0) + (nb > 0);
+  int cnt[10];
+  cnt[0] = rows;
+#pragma unroll
+  for (int k = 0; k < 8; ++k)
+    cnt[1 + k] = (k == 0 ? full : 0) + (nr == 256 - 32 * k || (k == 7 && nr && nr < 32)) + (nb == 256 - 32 * k);
+  cnt[9] = nt;
+  int incl[10];
+#pragma unroll
+  for (int k = 0; k < 10; ++k) {
+    int v = cnt[k];
+#pragma unroll
+    for (int o = 1; o < 32; o <<= 1) {
+      const int a2 = __shfl_up_sync(0xffffffffu, v, o);
+      if (e >= o) v += a2;
+    }
+    incl[k] = v;
+  }
+  int tot[10];
+#pragma unroll
+  for (int k = 0; k < 10; ++k)
+    tot[k] = __shfl_sync(0xffffffffu, incl[k], 31);
+  const int r0 = incl[0] - rows;
+  const int most = __reduce_max_sync(0xffffffffu, c);
+  if (e == 31) {
+    ntiles[0] = tot[9];
+    ntiles[1] = most;  // routes of the busiest expert
+  }
+  int cbase[8];
+  {
+    int acc = 0;
+#pragma unroll
+    for (int k = 0; k < 8; ++k) {
+      cbase[k] = (k == 6) ? 0 : acc;
+      acc = (k == 5) ? 0 : acc + tot[1 + k];
+    }
+  }
+  const int B = tot[1] + tot[2] + tot[3] + tot[4] + tot[5] + tot[6];
+  const int p256 = cbase[0] + incl[1] - cnt[1];
+  for (int i = 0; i < full; ++i)
+    tiles[p256 + i] = make_int4(e, r0 + 256 * i, 256, 0);
+  if (nr == 256) tiles[p256 + full] = make_int4(e, r0 + 256 * full, 256, 0);
+#pragma unroll
+  for (int k = 1; k < 6; ++k)
+    if (nr == 256 - 32 * k) tiles[cbase[k] + incl[1 + k] - 1] = make_int4(e, r0 + 256 * full, nr, 0);
+  if (nr == 64) tiles[B + cbase[6] + incl[7] - 1] = make_int4(e, r0 + 256 * full, 64, 0);
+  if (nr && nr <= 32) tiles[B + cbase[7] + incl[8] - 1] = make_int4(e, r0 + 256 * full, nr, 0);
+  if (nb == 64) tiles[B + cbase[6] + incl[7] - 1] = make_int4(e, r0 + 256 * full + nr, 64, 0);
+  if (nb == 32) tiles[B + cbase[7] + incl[8] - 1] = make_int4(e, r0 + 256 * full + nr, 32, 0);
+}
+
+inline constexpr int kPadFillParts = 8;  // pad-fill blocks per expert (fewer blocks: the grid fits one wave at small T)
+
+__global__ void __launch_bounds__(256, 1) moe_gather_kernel(
+    const __nv_bfloat16* __restrict__ p,
+    const __nv_bfloat16* __restrict__ gw,
+    const int* __restrict__ lid,
+    const int* __restrict__ pos,
+    const int* __restrict__ counts,
+    uint8_t* __restrict__ xt,
+    int* __restrict__ rrow,
+    int T,
+    float eps,
+    int4* __restrict__ tiles,
+    int* __restrict__ ntiles,
+    int fine,
+    long long* __restrict__ rdst,
+    const long long* __restrict__ owner_bases,
+    int rows_per_owner) {
+  pdl_enter();
+  const int tok = blockIdx.x;
+  const int tid = threadIdx.x;
+  __shared__ float red[8];
+  __shared__ int off_s[32], fine_s;
+  if (tid < 32) {
+    const int c = counts[tid];
+    const bool few = fine == 2 && T <= 32 && __popc(__ballot_sync(0xffffffffu, c > 0)) < 7;
+    if (fine == 2 && (few || __reduce_max_sync(0xffffffffu, c) > 64)) fine = 0;
+    if (tid == 0) fine_s = fine;
+    const int full = c >> 8, r = c & 255;
+    int nr, nb;
+    rem_tiles(r, fine, nr, nb);
+    const int rows = full * 256 + nr + nb;
+    int v = rows;
+#pragma unroll
+    for (int o = 1; o < 32; o <<= 1) {
+      const int a2 = __shfl_up_sync(0xffffffffu, v, o);
+      if (tid >= o) v += a2;
+    }
+    off_s[tid] = v - rows;
+    if (blockIdx.x == 0) plan_warp(counts, tiles, ntiles, fine, tid);
+    if (blockIdx.x == 0 && few && tid == 31) ntiles[1] = 256;  // and the two-warpgroup grid runs it
+  }
+  const int* offsets = off_s;
+  if (tok >= T) {
+    __syncthreads();
+    fine = fine_s;
+    const int idx = tok - T, e = idx / kPadFillParts, part = idx % kPadFillParts;
+    const int c = counts[e];
+    const int full = c >> 8, r = c & 255;
+    int nr, nb;
+    rem_tiles(r, fine, nr, nb);
+#pragma unroll
+    for (int q = 0; q < 2; ++q) {
+      const int n = q ? nb : nr;
+      if (n == 0) continue;
+      const int r0 = offsets[e] + 256 * full + (q ? nr : 0);
+      const int used = q ? r - nr : (r < nr ? r : nr);
+      for (int lr = used + part; lr < n; lr += kPadFillParts) {
+        if (rdst && tid == 0) rdst[r0 + lr] = 0;
+        for (int i = tid; i < 64 * 8; i += 256) {
+          const int stg = i >> 3, ch = i & 7;
+          *reinterpret_cast<uint4*>(xt + (size_t)r0 * 8192 + (size_t)stg * n * 128 + lr * 128 + ch * 16) =
+              make_uint4(0, 0, 0, 0);
+        }
+      }
+    }
+    return;
+  }
+  const uint4* src = reinterpret_cast<const uint4*>(p + (size_t)tok * 4096 + tid * 16);
+  uint4 v0 = src[0], v1 = src[1];
+  __shared__ long long mrow[8];
+  __shared__ int mn[8], mlr[8];
+  __syncwarp();
+  if (tid < 8) {
+    const int k = tid;
+    const int l = lid[tok * 8 + k];
+    if (l < 0) {
+      rrow[tok * 8 + k] = -1;
+      mn[k] = 0;
+    } else {
+      const int ps = pos[tok * 8 + k];
+      const int c = counts[l];
+      const int full = c >> 8, r = c & 255;
+      int nr, nb;
+      rem_tiles(r, fine, nr, nb);
+      const int tl = ps >> 8;
+      int row0 = offsets[l] + 256 * tl, lr = ps & 255, n = tl < full ? 256 : nr;
+      if (tl >= full && nb && lr >= nr) {  // a split remainder's second tile
+        row0 += nr;
+        lr -= nr;
+        n = nb;
+      }
+      rrow[tok * 8 + k] = row0 + lr;
+      // Pair row (token, k) of the token's owner: [rows_per_owner][8][4096] bf16 from its base.
+      if (rdst) rdst[row0 + lr] = owner_bases[tok / rows_per_owner] + ((long long)(tok % rows_per_owner) * kTopK + k) * 8192;
+      mrow[k] = (long long)row0 * 8192 + lr * 128;
+      mn[k] = n;
+      mlr[k] = lr;
+    }
+  }
+  float f[16];
+  const __nv_bfloat162* h0 = reinterpret_cast<const __nv_bfloat162*>(&v0);
+  const __nv_bfloat162* h1 = reinterpret_cast<const __nv_bfloat162*>(&v1);
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    float2 a = __bfloat1622float2(h0[i]), b = __bfloat1622float2(h1[i]);
+    f[2 * i] = a.x;
+    f[2 * i + 1] = a.y;
+    f[8 + 2 * i] = b.x;
+    f[8 + 2 * i + 1] = b.y;
+  }
+  float ss = 0.f;
+#pragma unroll
+  for (int i = 0; i < 16; ++i)
+    ss += f[i] * f[i];
+#pragma unroll
+  for (int o = 16; o > 0; o >>= 1)
+    ss += __shfl_xor_sync(0xffffffffu, ss, o);
+  if ((tid & 31) == 0) red[tid >> 5] = ss;
+  __syncthreads();
+  float tot = 0.f;
+#pragma unroll
+  for (int i = 0; i < 8; ++i)
+    tot += red[i];
+  const float rr = rsqrtf(tot / 4096.f + eps);
+  uint32_t outw[8];
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    const uint2 gv = __ldg(reinterpret_cast<const uint2*>(gw + tid * 16 + 4 * i));
+    const float2 g0 = __bfloat1622float2(*reinterpret_cast<const __nv_bfloat162*>(&gv.x));
+    const float2 g1 = __bfloat1622float2(*reinterpret_cast<const __nv_bfloat162*>(&gv.y));
+    __nv_bfloat162 a = __floats2bfloat162_rn(f[4 * i] * rr * g0.x, f[4 * i + 1] * rr * g0.y);
+    __nv_bfloat162 b = __floats2bfloat162_rn(f[4 * i + 2] * rr * g1.x, f[4 * i + 3] * rr * g1.y);
+    outw[2 * i] = bf162_u32(a);
+    outw[2 * i + 1] = bf162_u32(b);
+  }
+  const int stg = tid >> 2, ch0 = 2 * (tid & 3);
+#pragma unroll
+  for (int k = 0; k < 8; ++k) {
+    const int n = mn[k];  // (written before the reduction's __syncthreads)
+    if (n == 0) continue;
+    const int lr = mlr[k];
+    uint8_t* rowp = xt + mrow[k] + (size_t)stg * n * 128;
+    const int x = lr & 7;
+    *reinterpret_cast<uint4*>(rowp + ((ch0 ^ x) << 4)) = make_uint4(outw[0], outw[1], outw[2], outw[3]);
+    *reinterpret_cast<uint4*>(rowp + (((ch0 + 1) ^ x) << 4)) = make_uint4(outw[4], outw[5], outw[6], outw[7]);
+  }
+}
+
+inline constexpr int kRouteWarps = 16;  // arbitrary split of tokens into warps; 16 measured no worse than 32
+
+__global__ void __launch_bounds__(kRouteWarps * 32) moe_route_pairs_kernel(
+    const int* __restrict__ ids,
+    int offset,
+    int* __restrict__ lid,
+    int* __restrict__ pos,
+    int* __restrict__ cnt,
+    int T) {
+  pdl_enter();
+  __shared__ int s_cnt[32], s_base[32];
+  const int t = blockIdx.x * kRouteWarps + (threadIdx.x >> 5), lane = threadIdx.x & 31;
+  if (threadIdx.x < 32) s_cnt[threadIdx.x] = 0;
+  __syncthreads();
+  int loc = 0, lpos = 0;
+  bool local = false;
+  if (t < T && lane < 8) {
+    const int e = ids[t * 8 + lane];
+    loc = e - offset;
+    local = e >= 0 && loc >= 0 && loc < kLocalExperts;
+    if (local) lpos = atomicAdd(&s_cnt[loc], 1);
+  }
+  __syncthreads();
+  if (threadIdx.x < 32) {
+    const int c = s_cnt[threadIdx.x];
+    s_base[threadIdx.x] = c ? atomicAdd(cnt + threadIdx.x, c) : 0;
+  }
+  __syncthreads();
+  if (t < T && lane < 8) {
+    lid[t * 8 + lane] = local ? loc : -1;
+    pos[t * 8 + lane] = local ? s_base[loc] + lpos : 0;
+  }
+}
+
+inline void route_pairs(
+    tvm::ffi::TensorView ids,
+    int64_t offset,
+    tvm::ffi::TensorView lid,
+    tvm::ffi::TensorView pos,
+    tvm::ffi::TensorView cnt) {
+  using namespace host;
+  SymbolicSize T = {"num_tokens"};
+  SymbolicDevice device_;
+  device_.set_options<kDLCUDA>();
+  TensorMatcher({T, int64_t{kTopK}})  //
+      .with_dtype<int32_t>()
+      .with_device<kDLCUDA>(device_)
+      .verify(ids)
+      .verify(lid)
+      .verify(pos);
+  TensorMatcher({int64_t{kLocalExperts}}).with_dtype<int32_t>().with_device<kDLCUDA>(device_).verify(cnt);
+  const auto num_tokens = static_cast<int32_t>(T.unwrap());
+  LaunchKernel(static_cast<uint32_t>(div_ceil(num_tokens, kRouteWarps)), kRouteWarps * 32, device_.unwrap())
+      .enable_pdl(true)(
+          moe_route_pairs_kernel,
+          static_cast<const int*>(ids.data_ptr()),
+          static_cast<int>(offset),
+          static_cast<int*>(lid.data_ptr()),
+          static_cast<int*>(pos.data_ptr()),
+          static_cast<int*>(cnt.data_ptr()),
+          num_tokens);
+}
+
+__global__ void __launch_bounds__(kRouteWarps * 32) moe_route_pairs_one_block_kernel(
+    const int* __restrict__ ids,
+    int offset,
+    int* __restrict__ lid,
+    int* __restrict__ pos,
+    int* __restrict__ cnt,
+    int* __restrict__ zero,
+    int num_zero,
+    int T) {
+  pdl_enter();
+  __shared__ int s_cnt[kLocalExperts];
+  if (threadIdx.x < kLocalExperts) s_cnt[threadIdx.x] = 0;
+  for (int i = threadIdx.x; i < num_zero; i += blockDim.x)
+    zero[i] = 0;
+  __syncthreads();
+  for (int i = threadIdx.x; i < T * kTopK; i += blockDim.x) {
+    const int e = ids[i], loc = e - offset;
+    const bool local = e >= 0 && loc >= 0 && loc < kLocalExperts;
+    lid[i] = local ? loc : -1;
+    pos[i] = local ? atomicAdd(&s_cnt[loc], 1) : 0;
+  }
+  __syncthreads();
+  if (threadIdx.x < kLocalExperts) cnt[threadIdx.x] = s_cnt[threadIdx.x];
+}
+
+inline void route_pairs_one_block(
+    tvm::ffi::TensorView ids,
+    int64_t offset,
+    tvm::ffi::TensorView lid,
+    tvm::ffi::TensorView pos,
+    tvm::ffi::TensorView cnt,
+    tvm::ffi::TensorView zero) {
+  using namespace host;
+  SymbolicSize T = {"num_tokens"}, Z = {"num_zero"};
+  SymbolicDevice device_;
+  device_.set_options<kDLCUDA>();
+  TensorMatcher({T, int64_t{kTopK}})  //
+      .with_dtype<int32_t>()
+      .with_device<kDLCUDA>(device_)
+      .verify(ids)
+      .verify(lid)
+      .verify(pos);
+  TensorMatcher({int64_t{kLocalExperts}}).with_dtype<int32_t>().with_device<kDLCUDA>(device_).verify(cnt);
+  TensorMatcher({Z}).with_dtype<int32_t>().with_device<kDLCUDA>(device_).verify(zero);
+  LaunchKernel(1, kRouteWarps * 32, device_.unwrap())
+      .enable_pdl(true)(
+          moe_route_pairs_one_block_kernel,
+          static_cast<const int*>(ids.data_ptr()),
+          static_cast<int>(offset),
+          static_cast<int*>(lid.data_ptr()),
+          static_cast<int*>(pos.data_ptr()),
+          static_cast<int*>(cnt.data_ptr()),
+          static_cast<int*>(zero.data_ptr()),
+          static_cast<int>(Z.unwrap()),
+          static_cast<int>(T.unwrap()));
+}
+
+inline constexpr int kCombineThreads = 512;  // 8 columns per thread
+
+// Sums the token's normed, score-weighted routes in slot order, as the Triton combine does. One block per token and
+// per SM (102 registers): the caller keeps it to a single wave.
+template <bool kWeightFirst>
+__global__ void __launch_bounds__(kCombineThreads) moe_combine_kernel(
+    const __nv_bfloat16* __restrict__ y,
+    const int* __restrict__ rrow,
+    const int* __restrict__ lid,
+    const float* __restrict__ w,
+    const __nv_bfloat16* __restrict__ nw,
+    __nv_bfloat16* __restrict__ out,
+    float eps) {
+  pdl_enter();
+  const int t = blockIdx.x, tid = threadIdx.x, warp = tid >> 5, lane = tid & 31;
+  __shared__ float red[kTopK][kCombineThreads / 32];
+  float g[8];
+  {
+    const uint4 gv = *reinterpret_cast<const uint4*>(nw + tid * 8);
+    const __nv_bfloat162* gh = reinterpret_cast<const __nv_bfloat162*>(&gv);
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+      const float2 f = __bfloat1622float2(gh[i]);
+      g[2 * i] = f.x;
+      g[2 * i + 1] = f.y;
+    }
+  }
+  bool live[kTopK];
+  float x[kTopK][8];
+#pragma unroll
+  for (int k = 0; k < kTopK; ++k) {
+    live[k] = lid[t * kTopK + k] >= 0;
+    uint4 v = make_uint4(0, 0, 0, 0);
+    if (live[k]) v = *reinterpret_cast<const uint4*>(y + (size_t)rrow[t * kTopK + k] * kHidden + tid * 8);
+    const __nv_bfloat162* h = reinterpret_cast<const __nv_bfloat162*>(&v);
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+      const float2 f = __bfloat1622float2(h[i]);
+      x[k][2 * i] = kWeightFirst ? f.x * g[2 * i] : f.x;
+      x[k][2 * i + 1] = kWeightFirst ? f.y * g[2 * i + 1] : f.y;
+    }
+  }
+#pragma unroll
+  for (int k = 0; k < kTopK; ++k) {
+    float ss = 0.f;
+#pragma unroll
+    for (int i = 0; i < 8; ++i)
+      ss += x[k][i] * x[k][i];
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1)
+      ss += __shfl_xor_sync(0xffffffffu, ss, o);
+    if (lane == 0) red[k][warp] = ss;
+  }
+  __syncthreads();
+  float acc[8] = {};
+#pragma unroll
+  for (int k = 0; k < kTopK; ++k) {
+    if (!live[k]) continue;
+    float tot = 0.f;
+#pragma unroll
+    for (int i = 0; i < kCombineThreads / 32; ++i)
+      tot += red[k][i];
+    const float r = rsqrtf(tot / kHidden + eps), wk = w[t * kTopK + k];
+#pragma unroll
+    for (int i = 0; i < 8; ++i)
+      acc[i] += (kWeightFirst ? x[k][i] * r : x[k][i] * r * g[i]) * wk;
+  }
+  uint4 o;
+  uint32_t* ow = reinterpret_cast<uint32_t*>(&o);
+#pragma unroll
+  for (int i = 0; i < 4; ++i)
+    ow[i] = bf162_u32(__floats2bfloat162_rn(acc[2 * i], acc[2 * i + 1]));
+  *reinterpret_cast<uint4*>(out + (size_t)t * kHidden + tid * 8) = o;
+}
+
+/**
+ * \brief Post-expert norm and weighted sum of each token's local routes (decode-sized batches).
+ *
+ * \param y            [rows, 4096] bf16 expert outputs, row-major
+ * \param rrow,lid     int32 [T, 8] from gather_plan and route_pairs
+ * \param w            fp32 [T, 8] router scores
+ * \param norm_weight  [4096] bf16 post-expert norm weight
+ * \param out          [T, 4096] bf16 output; a token with no local route gets zeros
+ * \param eps          RMSNorm eps
+ * \param weight_first multiply by the norm weight before the RMS (Muse's post-expert norm) instead of after
+ */
+inline void combine(
+    tvm::ffi::TensorView y,
+    tvm::ffi::TensorView rrow,
+    tvm::ffi::TensorView lid,
+    tvm::ffi::TensorView w,
+    tvm::ffi::TensorView norm_weight,
+    tvm::ffi::TensorView out,
+    double eps,
+    bool weight_first) {
+  using namespace host;
+  SymbolicSize T = {"num_tokens"}, rows = {"rows"};
+  SymbolicDevice device_;
+  device_.set_options<kDLCUDA>();
+  TensorMatcher({rows, int64_t{kHidden}}).with_dtype<bf16_t>().with_device<kDLCUDA>(device_).verify(y);
+  TensorMatcher({T, int64_t{kTopK}})  //
+      .with_dtype<int32_t>()
+      .with_device<kDLCUDA>(device_)
+      .verify(rrow)
+      .verify(lid);
+  TensorMatcher({T, int64_t{kTopK}}).with_dtype<fp32_t>().with_device<kDLCUDA>(device_).verify(w);
+  TensorMatcher({int64_t{kHidden}}).with_dtype<bf16_t>().with_device<kDLCUDA>(device_).verify(norm_weight);
+  TensorMatcher({T, int64_t{kHidden}}).with_dtype<bf16_t>().with_device<kDLCUDA>(device_).verify(out);
+  const auto launch = [&](auto kernel) {
+    LaunchKernel(static_cast<uint32_t>(T.unwrap()), kCombineThreads, device_.unwrap())
+        .enable_pdl(true)(
+            kernel,
+            static_cast<const bf16_t*>(y.data_ptr()),
+            static_cast<const int*>(rrow.data_ptr()),
+            static_cast<const int*>(lid.data_ptr()),
+            static_cast<const fp32_t*>(w.data_ptr()),
+            static_cast<const bf16_t*>(norm_weight.data_ptr()),
+            static_cast<bf16_t*>(out.data_ptr()),
+            static_cast<float>(eps));
+  };
+  if (weight_first) {
+    launch(moe_combine_kernel<true>);
+  } else {
+    launch(moe_combine_kernel<false>);
+  }
+}
+
+/**
+ * \brief Normalize the expert input, write it into the tile layout and build the tile plan.
+ *
+ * \param p                [T, 4096] bf16 expert input
+ * \param pre_norm_weight  [4096] bf16 effective pre-expert-norm weight
+ * \param lid,pos          int32 [T, 8] from route_pairs
+ * \param counts           int32 [32] per-expert route counts
+ * \param xt               [rows, 4096] bf16 output in tile layout
+ * \param rrow             int32 [T, 8] output, row of each local route or -1
+ * \param tiles            int32 [max_tiles, 4] output tile list
+ * \param ntiles           int32 [1] output tile count
+ * \param eps              RMSNorm eps of the pre-expert norm
+ * \param fine             remainder tiles round to 32 rows; must match the launch of fused; 2: row split's 8 / 16 too
+ * \param row_dst          int64 [rows] output when rows_per_owner > 0: each row's pair-row address, 0 for pad rows
+ * \param owner_bases      int64 per owner: base address of its [rows_per_owner][8][4096] bf16 pair rows
+ */
+inline void gather_plan(
+    tvm::ffi::TensorView p,
+    tvm::ffi::TensorView pre_norm_weight,
+    tvm::ffi::TensorView lid,
+    tvm::ffi::TensorView pos,
+    tvm::ffi::TensorView counts,
+    tvm::ffi::TensorView xt,
+    tvm::ffi::TensorView rrow,
+    tvm::ffi::TensorView tiles,
+    tvm::ffi::TensorView ntiles,
+    double eps,
+    int64_t fine,
+    tvm::ffi::TensorView row_dst,
+    tvm::ffi::TensorView owner_bases,
+    int64_t rows_per_owner) {
+  using namespace host;
+  SymbolicSize T = {"num_tokens"};
+  SymbolicDevice device_;
+  device_.set_options<kDLCUDA>();
+  TensorMatcher({T, int64_t{kHidden}}).with_dtype<bf16_t>().with_device<kDLCUDA>(device_).verify(p);
+  TensorMatcher({int64_t{kHidden}}).with_dtype<bf16_t>().with_device<kDLCUDA>(device_).verify(pre_norm_weight);
+  TensorMatcher({T, int64_t{kTopK}})  //
+      .with_dtype<int32_t>()
+      .with_device<kDLCUDA>(device_)
+      .verify(lid)
+      .verify(pos)
+      .verify(rrow);
+  TensorMatcher({int64_t{kLocalExperts}}).with_dtype<int32_t>().with_device<kDLCUDA>(device_).verify(counts);
+  SymbolicSize rows = {"rows"}, max_tiles = {"max_tiles"};
+  TensorMatcher({rows, int64_t{kHidden}}).with_dtype<bf16_t>().with_device<kDLCUDA>(device_).verify(xt);
+  TensorMatcher({max_tiles, int64_t{4}}).with_dtype<int32_t>().with_device<kDLCUDA>(device_).verify(tiles);
+  TensorMatcher({int64_t{2}}).with_dtype<int32_t>().with_device<kDLCUDA>(device_).verify(ntiles);
+  const bool pairs = rows_per_owner > 0;
+  if (pairs) {
+    SymbolicSize owners = {"owners"};
+    TensorMatcher({rows}).with_dtype<int64_t>().with_device<kDLCUDA>(device_).verify(row_dst);
+    TensorMatcher({owners}).with_dtype<int64_t>().with_device<kDLCUDA>(device_).verify(owner_bases);
+  }
+  const auto num_tokens = static_cast<int32_t>(T.unwrap());
+  LaunchKernel(static_cast<uint32_t>(num_tokens + kLocalExperts * kPadFillParts), 256, device_.unwrap())
+      .enable_pdl(true)(
+          moe_gather_kernel,
+          static_cast<const bf16_t*>(p.data_ptr()),
+          static_cast<const bf16_t*>(pre_norm_weight.data_ptr()),
+          static_cast<const int*>(lid.data_ptr()),
+          static_cast<const int*>(pos.data_ptr()),
+          static_cast<const int*>(counts.data_ptr()),
+          static_cast<uint8_t*>(xt.data_ptr()),
+          static_cast<int*>(rrow.data_ptr()),
+          num_tokens,
+          static_cast<float>(eps),
+          static_cast<int4*>(tiles.data_ptr()),
+          static_cast<int*>(ntiles.data_ptr()),
+          static_cast<int>(fine),
+          pairs ? static_cast<long long*>(row_dst.data_ptr()) : nullptr,
+          pairs ? static_cast<const long long*>(owner_bases.data_ptr()) : nullptr,
+          static_cast<int>(pairs ? rows_per_owner : 1));
+}
+
+template <bool kFastScale, int kFine, int kSlots = NSLOT, int kSlotBytes = SLOT, int kWG = 2>
+void launch_fused(const FusedArgs& fa, uint32_t num_blocks, DLDevice device) {
+  static const bool smem_ready = [] {
+    CHECK_CUDA(cudaFuncSetAttribute(
+        moe_fused_persistent<kFine, kFastScale, kSlots, kSlotBytes, kWG>,
+        cudaFuncAttributeMaxDynamicSharedMemorySize,
+        kSmemBytes));
+    return true;
+  }();
+  (void)smem_ready;
+  host::LaunchKernel(num_blocks, 128 * (kWG + 1), device, kSmemBytes)
+      .enable_pdl(true)(moe_fused_persistent<kFine, kFastScale, kSlots, kSlotBytes, kWG>, fa);
+}
+
+/**
+ * \brief Both routed-expert GEMMs in one persistent launch.
+ *
+ * \tparam kFastScale exact only for E4M3 scale bytes in 0x08..0x7E (and 0x00 with zeroed codes)
+ * \param w13,w2      uint8 [32, 64 or 32, 64, 4608] repacked weights
+ * \param xt          [rows, 4096] bf16 activations in tile layout, from gather_plan
+ * \param inter       [rows, 4096] bf16 scratch, GEMM1 output in tile layout
+ * \param y           [rows, 4096] bf16 output, row-major
+ * \param tiles       int32 [max_tiles, 4] tile plan
+ * \param ntiles      int32 [2] from gather_plan
+ * \param gs13,gs2    fp32 [32] per-expert global scales
+ * \param counter     int32 [2], zeroed by the caller
+ * \param done        int32 [max_tiles], zeroed by the caller
+ * \param fine        must match the gather_plan launch
+ * \param row_split   four consumer warpgroups on items of two ntiles when no expert has over 64 routes (ntiles[1]);
+ *                    2: otherwise the kernel below runs the plan (on counter[1])
+ * \param narrow      every tile has 32 rows (at most 32 tokens): run the deeper narrow ring
+ * \param row_dst     int64 [rows] from gather_plan, read when row_stores: GEMM2 stores each row there, not to y
+ */
+template <bool kFastScale>
+void fused(
+    tvm::ffi::TensorView w13,
+    tvm::ffi::TensorView w2,
+    tvm::ffi::TensorView xt,
+    tvm::ffi::TensorView inter,
+    tvm::ffi::TensorView y,
+    tvm::ffi::TensorView tiles,
+    tvm::ffi::TensorView ntiles,
+    tvm::ffi::TensorView gs13,
+    tvm::ffi::TensorView gs2,
+    tvm::ffi::TensorView counter,
+    tvm::ffi::TensorView done,
+    bool fine,
+    int64_t row_split,
+    bool narrow,
+    tvm::ffi::TensorView row_dst,
+    bool row_stores) {
+  using namespace host;
+  SymbolicDevice device_;
+  device_.set_options<kDLCUDA>();
+  const int64_t kE = kLocalExperts, kKS = KS, kW = WBLK;
+  TensorMatcher({kE, int64_t{64}, kKS, kW}).with_dtype<uint8_t>().with_device<kDLCUDA>(device_).verify(w13);
+  TensorMatcher({kE, int64_t{32}, kKS, kW}).with_dtype<uint8_t>().with_device<kDLCUDA>(device_).verify(w2);
+  SymbolicSize rows = {"rows"}, max_tiles = {"max_tiles"};
+  TensorMatcher({rows, int64_t{kHidden}})  //
+      .with_dtype<bf16_t>()
+      .with_device<kDLCUDA>(device_)
+      .verify(xt)
+      .verify(inter)
+      .verify(y);
+  TensorMatcher({max_tiles, int64_t{4}}).with_dtype<int32_t>().with_device<kDLCUDA>(device_).verify(tiles);
+  TensorMatcher({int64_t{2}})  //
+      .with_dtype<int32_t>()
+      .with_device<kDLCUDA>(device_)
+      .verify(ntiles)
+      .verify(counter);
+  TensorMatcher({kE}).with_dtype<fp32_t>().with_device<kDLCUDA>(device_).verify(gs13).verify(gs2);
+  TensorMatcher({max_tiles}).with_dtype<int32_t>().with_device<kDLCUDA>(device_).verify(done);
+  if (row_stores) {
+    RuntimeCheck(fine && !row_split, "pair-row stores run on the fine-tile kernel only");
+    TensorMatcher({rows}).with_dtype<int64_t>().with_device<kDLCUDA>(device_).verify(row_dst);
+  }
+  const DLDevice device = device_.unwrap();
+
+  const auto make_args = [&](const void* wrep, const void* x, void* out, const fp32_t* gscale, int nt) {
+    Args a;
+    a.wrep = static_cast<const uint8_t*>(wrep);
+    a.xt = static_cast<const uint8_t*>(x);
+    a.tiles = static_cast<const int4*>(tiles.data_ptr());
+    a.ntiles = static_cast<const int*>(ntiles.data_ptr());
+    a.gscale = gscale;
+    a.out = static_cast<uint8_t*>(out);
+    a.rdst = nullptr;
+    a.NT = nt;
+    a.counter = static_cast<int*>(counter.data_ptr());
+    a.mul16 = 16u;
+    a.mul64 = 64u;
+    return a;
+  };
+  FusedArgs fa;
+  fa.g1 = make_args(w13.data_ptr(), xt.data_ptr(), inter.data_ptr(), static_cast<const fp32_t*>(gs13.data_ptr()), 64);
+  fa.g2 = make_args(w2.data_ptr(), inter.data_ptr(), y.data_ptr(), static_cast<const fp32_t*>(gs2.data_ptr()), 32);
+  if (row_stores) fa.g2.rdst = static_cast<const long long*>(row_dst.data_ptr());
+  fa.done = static_cast<int*>(done.data_ptr());
+  fa.flags = 0;
+  const auto num_blocks = static_cast<uint32_t>(runtime::get_sm_count(device.device_id));
+  if (row_split) {
+    fa.g1.NT /= 2;
+    fa.g2.NT /= 2;
+    launch_fused<kFastScale, 0, kRowSplitSlots, kRowSplitSlotBytes, 4>(fa, num_blocks, device);
+    if (row_split == 1) return;
+    fa.g1.NT *= 2;
+    fa.g2.NT *= 2;
+    fa.g1.counter = fa.g2.counter = fa.g1.counter + 1;
+    fa.flags = 4;
+  }
+  if (fine) {
+    launch_fused<kFastScale, 1>(fa, num_blocks, device);
+  } else if (narrow) {
+    launch_fused<kFastScale, 0, kNarrowSlots, kNarrowSlotBytes>(fa, num_blocks, device);
+  } else {
+    launch_fused<kFastScale, 0>(fa, num_blocks, device);
+  }
+}
+
+}  // namespace muse_spark_fp4
+}  // namespace sglang
