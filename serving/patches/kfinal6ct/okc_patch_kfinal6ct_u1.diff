+def all_reduce_input(group, rows: int, cols: int, dtype) -> Optional[torch.Tensor]:
+    """The workspace as the output of the producer of a multicast pull's input (no copy-in), else None."""
+    ca, nbytes = group.ca_comm, rows * cols * dtype.itemsize
+    if not isinstance(ca, CustomAllReduceV2) or ca.disabled:
+        return None
+    if ca.pull_enabled and nbytes <= ca.max_pull_size:
+        return _workspace_view(group, ca._pull_workspace[:nbytes].view(dtype).view(rows, cols))
