--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/muse_spark_decode_shard.py
@@ -0,0 +1,87 @@
+"""TP-sharded expert boundary for Muse Spark decode and target-verify batches.
+
+Each rank computes its 1/tp column block of both expert projections
+(``muse_spark_gemm_ag``) and its 1/tp expert block of the fp32 router, gathered by
+all-reducing zero-padded logits (exact). Blocks are views of the replicated weights.
+"""
+
+from __future__ import annotations
+
+from typing import Callable
+
+import torch
+
+from sglang.kernels.ops.communication.muse_spark_all_gather import MAX_TOKENS
+
+
+def decode_boundary_shard_enabled(
+    *, tp_size: int, ep_size: int, moe_tp_size: int
+) -> bool:
+    """Static gate: TP = EP in (4, 8) with whole experts per rank."""
+    return tp_size in (4, 8) and tp_size == ep_size and moe_tp_size == 1
+
+
+class MuseSparkDecodeShard:
+    """Per-rank view of the boundary weights and the router gather; one per model."""
+
+    def __init__(
+        self,
+        *,
+        rank: int,
+        world_size: int,
+        all_reduce: Callable[[torch.Tensor], torch.Tensor],
+    ):
+        self.rank = rank
+        self.world_size = world_size
+        self.all_reduce = all_reduce
+
+    def runs(self, forward_mode, num_tokens: int) -> bool:
+        """Decode and target-verify batches that fit the gather's push slot."""
+        return (
+            forward_mode.is_decode() or forward_mode.is_target_verify()
+        ) and 1 <= num_tokens <= MAX_TOKENS
+
+    def block(self, n: int) -> tuple[int, int]:
+        """(start, count) of this rank's block of ``n`` outputs."""
+        n_local = n // self.world_size
+        return self.rank * n_local, n_local
+
+    def rows(self, weight: torch.Tensor) -> torch.Tensor:
+        """This rank's contiguous ``[N / world, K]`` row block of ``weight``, a view."""
+        start, count = self.block(weight.shape[0])
+        return weight[start : start + count]
+
+    def router_logits_local(
+        self,
+        router_input: torch.Tensor,
+        weight: torch.Tensor,
+        out: torch.Tensor,
+    ) -> torch.Tensor:
+        """fp32 logits of this rank's expert block ``[M, E / world]``, the ``F.linear``
+        GEMM, into ``out`` (a column block of the gathered tensor)."""
+        return torch.mm(router_input, self.rows(weight).t(), out=out)
+
+    def new_router_logits(self, like: torch.Tensor, num_experts: int) -> torch.Tensor:
+        """Uninitialised fp32 ``[M + 2, E]`` gather scratch (pad rows: one strided fill);
+        allocate before the router side stream forks, which then never writes freed memory."""
+        return like.new_empty((like.shape[0] + 2, num_experts), dtype=torch.float32)
+
+    @staticmethod
+    def gathered(scratch: torch.Tensor) -> torch.Tensor:
+        """The contiguous ``[M, E]`` rows of the scratch that are all-reduced."""
+        return scratch[1:-1]
+
+    def local_block(self, scratch: torch.Tensor) -> torch.Tensor:
+        """This rank's ``[M, E / world]`` column block of the gathered rows."""
+        start, count = self.block(scratch.shape[1])
+        return scratch[1:-1, start : start + count]
+
+    def zero_other_blocks(self, scratch: torch.Tensor) -> None:
+        """Zero every column outside this rank's block in one fill; never touches ``local_block``, so it may run while the side stream writes the block."""
+        rows, n = scratch.shape
+        start, count = self.block(n)
+        scratch.as_strided(
+            (rows - 1, n - count),
+            (n, 1),
+            scratch.storage_offset() + start + count,
+        ).zero_()
