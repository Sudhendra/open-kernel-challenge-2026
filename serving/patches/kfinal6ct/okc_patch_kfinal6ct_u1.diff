+SGL_DEVICE uint32_t bf162_u32(__nv_bfloat162 v) {
+  return *reinterpret_cast<uint32_t*>(&v);
+}
+
+SGL_DEVICE __nv_bfloat162 u32_bf162(uint32_t v) {
+  return *reinterpret_cast<__nv_bfloat162*>(&v);
+}
+
+// Two E4M3 block scales (low byte: row g, high byte: row g+8) to bf16x2 of scale * 2^119, any E4M3 value but NaN.
+// The repack zeroes the codes of a zero-scale block, so the bf16 of byte 0 (2^104, not 0) only ever multiplies 0.
+SGL_DEVICE uint32_t scale_pair_exact(uint32_t s2) {
+  uint32_t h2;
+  asm("{\n.reg .b16 t;\ncvt.u16.u32 t, %1;\ncvt.rn.f16x2.e4m3x2 %0, t;\n}\n" : "=r"(h2) : "r"(s2));
+  // f16 (exact for every e4m3 value) to bf16 with the exponent rebiased by 112 + 119.
+  return ((h2 >> 3) & 0x0FFF0FFFu) + 0x73807380u;
+}
+
+// The scale pair of one k16 step from the 32-bit word holding two steps' pairs. For a normal E4M3 byte b the bf16 bits
+// of value * 2^119 are exactly (b << 4) + 0x7780; m16 is opaque so the multiply stays IMAD on the FMA pipe.
+template <bool kFastScale>
+SGL_DEVICE uint32_t scale_pair_sel(uint32_t w, int hi, uint32_t m16) {
+  if constexpr (kFastScale) {
+    return __byte_perm(w, 0u, hi ? 0x4342 : 0x4140) * m16 + 0x77807780u;
+  } else {
+    return scale_pair_exact((w >> (16 * hi)) & 0xFFFF);
+  }
+}
+
+// 8 E2M1 codes to 4 bf16x2 A-fragment registers (scaled). A register half holds (sign << 15 | magnitude << 6), which as
+// bf16 bits is exactly e2m1 * 2^-126 (subnormal for magnitude 1), times scale * 2^119. Bit positions in q (m0, m1, m2,
+// sign), written by the repack:
+//   a0: code A (6, 7, 8, 15),   code B (22, 23, 24, 31)
+//   a1: code A (2, 3, 4, 11),   code B (18, 19, 20, 27)
+//   a2: code A (28, 29, 30, 5), code B (12, 13, 14, 21)
+//   a3: code A (0, 1, 26, 9),   code B (16, 17, 10, 25)
+SGL_DEVICE void convert8(uint32_t q, uint32_t sb, uint32_t (&a)[4], uint32_t m16, uint32_t m64) {
+  const __nv_bfloat162 s = u32_bf162(sb);
+  const __nv_bfloat162 slo = __low2bfloat162(s), shi = __high2bfloat162(s);
+  constexpr uint32_t M = 0x81C081C0u;
+  const uint32_t r0 = q & M;
+  const uint32_t r1 = (q * m16) & M;
+  const uint32_t r2 = __funnelshift_l(q, q, 10) & M;
+  const uint32_t r3 = ((q * m64) & 0x80C080C0u) | (__funnelshift_l(q, q, 14) & 0x01000100u);
+  a[0] = bf162_u32(__hmul2(u32_bf162(r0), slo));
+  a[1] = bf162_u32(__hmul2(u32_bf162(r1), shi));
+  a[2] = bf162_u32(__hmul2(u32_bf162(r2), slo));
+  a[3] = bf162_u32(__hmul2(u32_bf162(r3), shi));
+}
+
+struct Args {
+  const uint8_t* wrep;  // [E][NT][KS][WBLK]
+  const uint8_t* xt;    // activations in tile layout (byte base; a tile starting at row r0 is at r0 * 8192)
+  const int4* tiles;    // (expert, row0, n, 0)
+  const int* ntiles;    // device scalar
+  const float* gscale;  // [E]
+  uint8_t* out;         // gated: tile layout (bytes); else row-major bf16 [rows, 4096]
+  const long long* rdst;  // GEMM2 of the FINE kernel, or null: per out row its pair-row address (0: a pad row)
+  int NT;
+  int* counter;           // persistent kernel work queue (zeroed before launch)
+  uint32_t mul16, mul64;  // 16 and 64 from the host: ptxas cannot fold them, so the multiplies stay IMAD
+};
+
+struct FusedArgs {
+  Args g1, g2;  // GEMM1 (gated, writes inter in tile layout) and GEMM2 (reads inter, writes y)
+  int* done;    // [max tiles] GEMM1 n-tiles finished per token tile (zeroed before launch)
+  int flags;    // 4: the row split's two-warpgroup grid; bits 1 and 2 are never set but are tested at runtime (see the producer loop)
+};
+
+inline constexpr int kKps32 = 4;
+inline constexpr int kKps64 = 2;
+inline constexpr int kKps128 = 2;
+SGL_DEVICE int kps_for(int n) {
+  return n >= 160 ? 1 : (n <= 32 ? kKps32 : (n <= 64 ? kKps64 : kKps128));
+}
+
+static_assert(kKps32 * (32 * 128 + WBLK) <= SLOT && 64 % kKps32 == 0, "kKps32: stage does not fit a ring slot");
+inline constexpr int kNarrowSlots = 6;
+inline constexpr int kNarrowSlotBytes = kKps32 * (32 * 128 + WBLK);
+inline constexpr int kRowSplitSlots = 3;
+inline constexpr int kRowSplitSlotBytes = kKps32 * (32 * 128 + 2 * WBLK);
+static_assert(kKps64 * (64 * 128 + WBLK) <= SLOT && 64 % kKps64 == 0, "kKps64: stage does not fit a ring slot");
+static_assert(kKps128 * (128 * 128 + WBLK) <= SLOT && 64 % kKps128 == 0, "kKps128: stage does not fit a ring slot");
+static_assert(256 * 128 + WBLK <= SLOT, "N=256 stage does not fit a ring slot");
+
+SGL_DEVICE void enqueue_out(volatile long long* pubq, void* dst, int* done, int kind, int amount) {
+  volatile int* cnt = reinterpret_cast<volatile int*>(pubq) - 3;  // base + 244
+  const int n = *cnt;
+  volatile long long* e = pubq + 4 * (n & 7);
+  e[0] = reinterpret_cast<long long>(dst);
+  e[1] = reinterpret_cast<long long>(done);
+  reinterpret_cast<volatile int*>(e)[4] = kind;
+  reinterpret_cast<volatile int*>(e)[5] = amount;
+  *cnt = n + 1;
+  asm volatile("st.release.cta.shared.b32 [%0], %1;" ::"r"(smem_u32((const void*)(pubq - 2))), "r"(n + 1) : "memory");
+}
+
+SGL_DEVICE void wait_staging_free(volatile long long* pubq) {
+  const int n = *(reinterpret_cast<volatile int*>(pubq) - 3);
+  const uint32_t a = smem_u32((const void*)(reinterpret_cast<volatile int*>(pubq) - 2));  // base + 248
+  while (true) {
+    int f;
+    asm volatile("ld.acquire.cta.shared.b32 %0, [%1];" : "=r"(f) : "r"(a) : "memory");
+    if (f >= n) break;
+  }
+}
+
+template <int N, bool kFastScale, int kSlots = NSLOT, int kSlotBytes = SLOT, int kWG = 2, bool kRows = false>
+SGL_DEVICE void consumer_item(
+    const Args& p,
+    uint8_t* ring,
+    uint8_t* stg,
+    uint32_t bars,
+    int& slot,
+    uint32_t& ph,
+    int e,
+    int row0,
+    int ntile,
+    bool gated,
+    int* done,
+    volatile long long* pubq) {
+  const uint32_t m16 = N <= 64 ? p.mul16 : 16u;
+  const uint32_t m64 = N <= 64 ? p.mul64 : 64u;
+  constexpr int KPS = N >= 160 ? 1 : (N <= 32 ? kKps32 : (N <= 64 ? kKps64 : kKps128));
+  constexpr int XB = N * 128;  // X bytes per k-stage
+  const int ctid = threadIdx.x - kFirstConsumer;
+  constexpr int kCT = kWG * 128;  // consumer threads
+  const int nto = kWG == 4 ? ctid >> 8 : 0, wg = kWG == 4 ? (ctid >> 7) & 1 : ctid >> 7;
+  const int w = (ctid >> 5) & 3;
+  const int lane = ctid & 31;
+  const int g = lane >> 2, t = lane & 3;
+  constexpr bool GROUP4 = N <= 128 && (kWG == 2 || N == 32);
+  constexpr int NACC = GROUP4 && kWG == 2 ? (N <= 32 ? 4 : 2) : 1;
+  float acc[128];
+  float acc2[128];
+  float acc3[128], acc4[128];
+#pragma unroll
+  for (int i = 0; i < N / 2; ++i)
+    acc[i] = 0.f;
+#pragma unroll
+  for (int i = 0; i < (NACC > 1 ? N / 2 : 0); ++i)
+    acc2[i] = 0.f;
+#pragma unroll
+  for (int i = 0; i < (NACC > 2 ? N / 2 : 0); ++i)
+    acc3[i] = 0.f;
+#pragma unroll
+  for (int i = 0; i < (NACC > 3 ? N / 2 : 0); ++i)
+    acc4[i] = 0.f;
+  uint32_t afrag[GROUP4 ? 8 : 2][4];
+  int prev = -1;
+  const int woff = nto * KPS * WBLK + ((wg * 4 + w) * 32 + lane) * 16;
+  const int soff = nto * KPS * WBLK + 4096 + ((wg * 4 + w) * 8 + g) * 8;
+  mbar_wait(bars + 8 * slot, ph);
+  uint4 nwq = *reinterpret_cast<const uint4*>(ring + slot * kSlotBytes + KPS * XB + woff);
+  uint2 nsc = *reinterpret_cast<const uint2*>(ring + slot * kSlotBytes + KPS * XB + soff);
+  for (int it = 0; it < KS / KPS; ++it) {
+    uint8_t* st = ring + slot * kSlotBytes;
+    const uint8_t* wbase = st + KPS * XB + woff;
+    const uint8_t* sbase = st + KPS * XB + soff;
+    const uint64_t dbase = desc_sw128(smem_u32(st));
+    if (it > 0) {
+      mbar_wait(bars + 8 * slot, ph);
+      nwq = *reinterpret_cast<const uint4*>(wbase);
+      nsc = *reinterpret_cast<const uint2*>(sbase);
+    }
+#pragma unroll
+    for (int kk = 0; kk < KPS; ++kk) {
+      const uint4 wq = nwq;
+      const uint2 sc = nsc;
+      if (kk + 1 < KPS) {
+        nwq = *reinterpret_cast<const uint4*>(wbase + (kk + 1) * WBLK);
+        nsc = *reinterpret_cast<const uint2*>(sbase + (kk + 1) * WBLK);
+      }
+      const uint64_t desc = dbase + static_cast<uint64_t>((kk * XB) >> 4);
+      if constexpr (GROUP4) {
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+          const uint32_t q = j == 0 ? wq.x : j == 1 ? wq.y : j == 2 ? wq.z : wq.w;
+          const uint32_t sw = j < 2 ? sc.x : sc.y;  // scales of k16 steps (j & ~1, j | 1): bytes 0,1 and 2,3
+          convert8(q, scale_pair_sel<kFastScale>(sw, j & 1, m16), afrag[(kk & 1) * 4 + j], m16, m64);
+        }
+        wg_fence();
+#pragma unroll
+        for (int j = 0; j < 4; ++j)
+          wgmma_rs<N>(
+              NACC > 2 ? ((kk & 1) ? ((j & 1) ? acc4 : acc2) : ((j & 1) ? acc3 : acc)) : NACC > 1 && (kk & 1) ? acc2 : acc,
+              afrag[(kk & 1) * 4 + j],
+              desc + 2 * j,
+              1);
