--- /dev/null
+++ b/python/sglang/srt/speculative/dflash_branch.py
@@ -0,0 +1,153 @@
+"""DFLASH branch rows: on a request whose drafter is unsure early, verify rows 6-7 carry an
+alternative path instead of the chain's drafts 6-7.
+
+Branch slot e in {1, 2, 3} (0 = plain chain) is the slot among 1-3 with the largest
+expected gain from the drafter's own lattice, when it outweighs the cut chain's loss. Rows 6-7 hold the rank-2 candidate at slot e and its lattice argmax
+successor, at positions p + e and p + e + 1; they see the prefix, rows 0..e-1 and
+themselves (fa3_verify_tree). Every committed token is still the target's greedy token.
+All device-side; the worker's per-step part is two launches.
+"""
+
+from __future__ import annotations
+
+import torch
+import triton
+import triton.language as tl
+
+ROWS = 8
+
+
+def pick_branch(
+    *,
+    candidate_ids: torch.Tensor,
+    scores: torch.Tensor,
+    greedy: torch.Tensor,
+    min_gain: float,
+    slot_out: torch.Tensor,
+    tokens_out: torch.Tensor,
+) -> None:
+    """``candidate_ids`` [bs, 7, K], ``scores`` [bs, 7, K, K] (slot, previous candidate,
+    candidate); writes ``slot_out`` int32 [bs] and ``tokens_out`` int64 [bs, 2].
+
+    Along the greedy chain p_j is the top row-softmax probability and surv_k = prod p_j.
+    A branch at slot e gains surv_(e-1) * q2_e * (1 + c1_e) expected drafts (q2: rank-2
+    probability, c1: top probability after it) and costs surv_6 + surv_7 (drafts 6-7)."""
+    k = scores.shape[-1]
+    _pick_kernel[(len(scores),)](candidate_ids.contiguous(), scores.contiguous(), greedy, min_gain, slot_out,
+                                 tokens_out, k, triton.next_power_of_2(k))
+
+
+# b request; e slot; m, z row max, sum(exp); r row minus its top; j rank-2 index; y row after j; g gain; w new best; i chain argmax
+@triton.jit
+def _pick_kernel(cand, s, greedy, min_gain, slot_out, tok_out, K: tl.constexpr, P: tl.constexpr):
+    b = tl.program_id(0).to(tl.int64)
+    c = tl.arange(0, P)
+    s += b * 7 * K * K + c
+    cand += b * 7 * K
+    i, surv, loss, best, slot, tok0, tok1 = 0, 1.0, 0.0, -1.0, 0, 0, 0
+    for e in tl.static_range(7):
+        x = tl.load(s + (e * K + i) * K, c < K, -float("inf")).to(tl.float32)
+        m = tl.max(x, 0)
+        z = tl.sum(tl.exp(x - m), 0)
+        if e < 3:
+            r = tl.where(c == tl.argmax(x, 0), -float("inf"), x)
+            j = tl.argmax(r, 0)
+            y = tl.load(s + (e * K + K + j) * K, c < K, -float("inf")).to(tl.float32)
+            g = surv * tl.exp(tl.max(r, 0) - m) / z * (1 + 1 / tl.sum(tl.exp(y - tl.max(y, 0)), 0))
+            w = g > best
+            best = tl.where(w, g, best)
+            slot = tl.where(w, e + 1, slot)
+            tok0 = tl.where(w, tl.load(cand + e * K + j), tok0)
+            tok1 = tl.where(w, tl.load(cand + e * K + K + tl.argmax(y, 0)), tok1)
+        surv = surv / z
+        if e > 4:
+            loss += surv
+        i = tl.argmax(x, 0)
+    tl.store(slot_out + b, tl.where(tl.load(greedy + b) & (best - loss > min_gain), slot, 0))
+    tl.store(tok_out + 2 * b, tok0)
+    tl.store(tok_out + 2 * b + 1, tok1)
+
+
+@triton.jit
+def _layout_kernel(tok_ptr, pos_ptr, drafter_ptr, draft_ptr, pick_ptr, btok_ptr, out_tok_ptr, out_pos_ptr, slot_ptr):
+    b = tl.program_id(0)
+    j = tl.arange(0, 8)
+    base = b * 8 + j
+    tok = tl.load(tok_ptr + base)
+    pos = tl.load(pos_ptr + base)
+    own = tl.load(drafter_ptr + b * 7 + j, mask=j < 7, other=0) == tl.load(draft_ptr + b * 7 + j, mask=j < 7, other=0)
+    e = tl.load(pick_ptr + b) * (tl.min(own.to(tl.int32), 0) > 0)
+    tail = (e > 0) & (j >= 6)
+    btok = tl.load(btok_ptr + b * 2 + j - 6, mask=j >= 6, other=0)
+    tl.store(out_tok_ptr + base, tl.where(tail, btok, tok))
+    tl.store(out_pos_ptr + base, tl.where(tail, tl.load(pos_ptr + b * 8) + e + j - 6, pos))
+    tl.store(slot_ptr + b, e.to(tl.int32))
+
+
+def branch_layout(*, tokens, positions, drafter_next, draft_next, pick_slot, pick_tokens) -> tuple:
+    """Verify tokens / positions [bs, 8] and branch slot int32 [bs]: rows 6-7 become the picked branch (positions p + e, p + e + 1) unless the lookup replaced the drafts."""
+    bs = tokens.shape[0]
+    out_tok, out_pos = torch.empty_like(tokens), torch.empty_like(positions)
+    slot = torch.empty((bs,), dtype=torch.int32, device=tokens.device)
+    _layout_kernel[(bs,)](tokens, positions, drafter_next.contiguous(), draft_next.contiguous(),
+                          pick_slot, pick_tokens, out_tok, out_pos, slot)
+    return out_tok, out_pos, slot
+
+
+@triton.jit
+def _accept_kernel(cand_ptr, pred_ptr, slot_ptr, prefix_ptr, rpi_ptr, r2t_ptr, r2t_stride, loc_ptr, pos_ptr,
+                   out_tok_ptr, accept_ptr, commit_ptr, new_len_ptr, bonus_ptr, rows_ptr, loc_out_ptr, pos_out_ptr,
+                   stats_ptr):
+    b = tl.program_id(0)
+    j = tl.arange(0, 8)
+    base = b * 8
+    pred = tl.load(pred_ptr + base + j)
+    e = tl.load(slot_ptr + b).to(tl.int64)
+    gated = e > 0
+    nxt = tl.load(cand_ptr + base + j + 1, mask=j < 7, other=-1)
+    match = (nxt == pred) & (j < tl.where(gated, 5, 7))
+    chain = tl.min(tl.where(match, 8, j), 0).to(tl.int64)
+    at_e = tl.load(pred_ptr + base + tl.maximum(e - 1, 0))
+    won = gated & (chain == e - 1) & (tl.load(cand_ptr + base + 6) == at_e)
+    both = won & (tl.load(cand_ptr + base + 7) == tl.load(pred_ptr + base + 6))
+    accept = tl.where(won, e + both.to(tl.int64), chain)
+    rows = tl.where(won & (j <= e + 1), tl.where(j < e, j, tl.where(j == e, 6, 7)), j)
+    j1 = j + 1
+    rows1 = tl.where(won & (j1 <= e + 1), tl.where(j1 < e, j1, tl.where(j1 == e, 6, 7)), j1)
+    bonus = tl.load(pred_ptr + base + tl.where(won, 6 + both.to(tl.int64), accept))
+    tok1 = tl.load(cand_ptr + base + rows1, mask=j < 7, other=0)
+    tl.store(out_tok_ptr + base + j, tl.where(j == accept, bonus, tok1))
+    tl.store(rows_ptr + base + j, rows)
+    tl.store(loc_out_ptr + base + j, tl.load(loc_ptr + base + rows))
+    tl.store(pos_out_ptr + base + j, tl.load(pos_ptr + base + rows))
+    tl.store(accept_ptr + b, accept.to(tl.int32))
+    tl.store(commit_ptr + b, (accept + 1).to(tl.int32))
+    tl.store(new_len_ptr + b, tl.load(prefix_ptr + b) + accept + 1)
+    tl.store(bonus_ptr + b, bonus)
+    row = tl.load(rpi_ptr + b).to(tl.int64) * r2t_stride + tl.load(prefix_ptr + b)
+    two = (j < 2) & won
+    va = tl.load(r2t_ptr + row + e + j, mask=two)
+    vb = tl.load(r2t_ptr + row + 6 + j, mask=two)
+    tl.store(r2t_ptr + row + e + j, vb, mask=two)
+    tl.store(r2t_ptr + row + 6 + j, va, mask=two)
+    tl.store(stats_ptr + b * 3, tl.load(stats_ptr + b * 3) + gated.to(tl.int64))
+    tl.store(stats_ptr + b * 3 + 1, tl.load(stats_ptr + b * 3 + 1) + won.to(tl.int64))
+    tl.store(stats_ptr + b * 3 + 2, tl.load(stats_ptr + b * 3 + 2) + tl.where(won, accept + 1, 0))
+
+
+def branch_accept(*, candidates, predict, branch_slot, prefix_lens, req_pool_indices, req_to_token, cache_loc,
+                  positions, stats) -> tuple:
+    """Greedy accept over the chain (5 drafts when gated) and the branch; a branch win also
+    swaps req_to_token. Returns accepted drafts, bonus, committed tokens [bs, 8], commit and
+    new lengths, and the verify rows / write slots / positions of the committed tokens."""
+    bs = candidates.shape[0]
+    dev = candidates.device
+    out = torch.empty((bs, ROWS), dtype=torch.int64, device=dev)
+    rows, loc, pos = torch.empty_like(out), torch.empty_like(out), torch.empty_like(out)
+    accept, commit = (torch.empty((bs,), dtype=torch.int32, device=dev) for _ in range(2))
+    new_lens = torch.empty_like(prefix_lens)
+    bonus = torch.empty((bs,), dtype=torch.int64, device=dev)
+    _accept_kernel[(bs,)](candidates, predict, branch_slot, prefix_lens, req_pool_indices, req_to_token,
+                          req_to_token.stride(0), cache_loc, positions, out, accept, commit, new_lens, bonus,
+                          rows, loc, pos, stats)
+    return accept, bonus, out, commit, new_lens, rows, loc, pos
