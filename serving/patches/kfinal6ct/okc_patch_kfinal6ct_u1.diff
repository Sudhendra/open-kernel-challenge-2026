+    normal = tl.minimum(normal, 0x7E)  # a round-up to 480 saturates too
+    code = tl.where(mag < (121 << 23), denorm, normal)
+    code = tl.where(mag >= (1087 << 20), tl.where(mag > 0x7F800000, 0x7F, 0x7E), code)
+    return ((code & 0xFF) | sign).to(tl.uint8)
