+SGL_DEVICE int rem_tile(int r, int fine) {
+  if (r == 0) return 0;
+  if (fine == 2 && r <= 16) return r <= 8 ? 8 : 16;  // row split, no expert over 64 rows
+  if (r <= 32) return 32;
+  if (r <= 64) return 64;
+  if (r <= 128) return 128;
+  if (fine && r <= 160) return 160;
+  if (fine && r <= 192) return 192;
+  return 256;
+}
+
+SGL_DEVICE void rem_tiles(int r, int fine, int& na, int& nb) {
+  if (!fine && r > 128 && r <= 192) {
+    na = 128;
+    nb = rem_tile(r - 128, 0);
+  } else {
+    na = rem_tile(r, fine);
+    nb = 0;
+  }
+}
