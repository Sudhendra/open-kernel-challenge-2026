+        wg_wait<1>();
+        if (kk == 0 && prev >= 0) mbar_arrive(bars + 8 * kSlots + 8 * prev);
+      } else {
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+          const uint32_t q = j == 0 ? wq.x : j == 1 ? wq.y : j == 2 ? wq.z : wq.w;
+          const uint32_t sw = j < 2 ? sc.x : sc.y;
