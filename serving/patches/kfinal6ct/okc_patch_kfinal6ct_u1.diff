--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/muse_spark_fa3_kv_store.py
@@ -0,0 +1,114 @@
+"""FA3 fp8 KV-cache write fused into the Muse QK-norm kernel at decode and verify, with
+the ``Tensor.to`` casts of stock ``set_kv_buffer`` (slot 0 skipped) and ``prepare_paged_mha_query``."""
+
+from __future__ import annotations
+
+import functools
+import logging
+from typing import Optional, Tuple
+
+import torch
+
+from sglang.srt.layers.cp.utils import is_cp_active
+from sglang.srt.layers.radix_attention import RadixAttention
+from sglang.srt.mem_cache.memory_pool import MHATokenToKVPool
+from sglang.srt.mem_cache.swa_memory_pool import SWAKVPool
+
+logger = logging.getLogger(__name__)
+
+KvStore = Tuple[torch.Tensor, torch.Tensor, torch.Tensor]
+
+
+@functools.cache
+def _backend_classes():
+    from sglang.srt.layers.attention.flashattention_backend import (
+        FlashAttentionBackend,
+    )
+    from sglang.srt.layers.attention.hybrid_attn_backend import HybridAttnBackend
+
+    return FlashAttentionBackend, HybridAttnBackend
+
+
+@functools.cache
+def _log_first_use() -> None:
+    logger.info("Muse FA3 fused QK-norm + fp8 KV store on")
+
+
+def fa3_target_backend(backend, forward_mode):
+    fa3_cls, hybrid_cls = _backend_classes()
+    if isinstance(backend, hybrid_cls):
+        backend = backend._select_backend(forward_mode)
+    if type(backend) is not fa3_cls or backend.fa_impl_ver != 3:
+        return None
+    return backend
+
+
+def _writes_plain_fp8(backend, attn: RadixAttention, forward_batch) -> bool:
+    """Every condition under which stock FA3 casts q, k, v with ``Tensor.to`` and stores k, v through ``MHATokenToKVPool.set_kv_buffer`` without scales."""
+    mode = forward_batch.forward_mode
+    return (
+        (mode.is_decode() or mode.is_target_verify())
+        and backend.kv_cache_dtype == torch.float8_e4m3fn
+        and backend.kv_cache_dtype_str != "auto"
+        and not backend.kv_cache_is_mxfp8
+        and attn.head_dim <= 256
+        and attn.head_dim == attn.v_head_dim
+        and attn.tp_k_head_num == attn.tp_v_head_num
+        and attn.k_scale is None
+        and attn.v_scale is None
+        and not attn.is_cross_attention
+        and not backend.use_mla
+        and not backend.fa_skip_kv_cache
+        and not backend.kv_index_translator.is_translating
+        and backend._kv_shard_pool is None
+        and forward_batch.dcp_kv_mask is None
+        and not is_cp_active(forward_batch)
+    )
+
+
+def _layer_rows(pool, attn: RadixAttention, forward_batch, backend):
+    """``(pool, pool layer id, slots)`` as ``SWAKVPool.set_kv_buffer`` resolves them."""
+    loc = forward_batch.out_cache_loc
+    layer_id = attn.layer_id
+    if isinstance(pool, SWAKVPool):
+        layer_id, is_swa = pool.layers_mapping[layer_id]
+        if is_swa:
+            swa_loc = backend.forward_metadata.swa_out_cache_loc
+            if swa_loc is None or swa_loc.shape[0] < loc.shape[0]:
+                return None
+            loc = swa_loc[: loc.shape[0]]
+        pool = pool.swa_kv_pool if is_swa else pool.full_kv_pool
+    return pool, layer_id, loc
+
+
+def fa3_fused_kv_store(
+    attn: RadixAttention, forward_batch, backend, pool
+) -> Optional[KvStore]:
+    """uint8 views ``[slots, heads * head_dim]`` of the layer's K and V and the write slots, when the fused kernel reproduces the stock FA3 write; else None."""
+    backend = fa3_target_backend(backend, forward_batch.forward_mode)
+    if backend is None or not _writes_plain_fp8(backend, attn, forward_batch):
+        return None
+    rows = _layer_rows(pool, attn, forward_batch, backend)
+    if rows is None:
+        return None
+    pool, layer_id, loc = rows
+    if (
+        type(pool) is not MHATokenToKVPool
+        or pool.dtype != torch.float8_e4m3fn
+        or pool.use_hnd
+        or pool.kv_cache_layout != "nhd"
+        or pool.is_quantized_kv_cache
+    ):
+        return None
+    index = layer_id - pool.start_layer
+    k_buf, v_buf = pool.k_buffer[index], pool.v_buffer[index]
+    shape = (attn.tp_k_head_num, attn.head_dim)
+    for buf in (k_buf, v_buf):
+        if buf.shape[1:] != shape or not buf.is_contiguous():
+            return None
+    _log_first_use()
+    return (
+        k_buf.view(torch.uint8).view(k_buf.shape[0], -1),
+        v_buf.view(torch.uint8).view(v_buf.shape[0], -1),
+        loc,
+    )
