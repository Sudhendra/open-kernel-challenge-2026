diff --git a/python/sglang/kernels/ops/moe/muse_spark_fp4_grouped.py b/python/sglang/kernels/ops/moe/muse_spark_fp4_grouped.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/kernels/ops/moe/muse_spark_fp4_grouped.py
@@ -0,0 +1,265 @@
+"""Grouped NVFP4 MoE kernels for Muse Spark's routed experts."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Optional
+
+import torch
+import triton
+import triton.language as tl
+
+from sglang.kernels.jit.utils import (
+    cache_once,
+    get_jit_cuda_arch,
+    load_jit,
+    make_cpp_args,
+)
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+_LOCAL_EXPERTS = 32
+_TOP_K = 8
+_HIDDEN = 4096
+_FINE_TILES_MIN_TOKENS = 512
+_MIN_TILE_ROWS = 32
+_MAX_TILES_SLACK = 2 * _LOCAL_EXPERTS
+_DECODE_MAX_TOKENS = 128
+# Up to this token count every expert tile has 32 rows (an expert gets at most one route per token), and the fused
+# kernel runs a deeper ring of 32-row slots. Measured 2.6-5.4 us faster per call at 8-32 tokens, bit-identical.
+_NARROW_MAX_TOKENS = 32
+_ROW_SPLIT_MAX_TOKENS = 256
+_ROW_SPLIT_MIN_TOKENS = 16
+
+
+@cache_once
+def _jit_grouped_moe_module(fast_scale: bool) -> Module:
+    if get_jit_cuda_arch().major != 9:
+        raise RuntimeError("muse_spark_fp4_grouped needs an sm_90 device")
+    args = make_cpp_args(fast_scale)
+    return load_jit(
+        "muse_spark_fp4_grouped",
+        *args,
+        cuda_files=["moe/muse_spark_fp4_grouped.cuh"],
+        cuda_wrappers=[
+            ("route_pairs", "muse_spark_fp4::route_pairs"),
+            ("route_pairs_one_block", "muse_spark_fp4::route_pairs_one_block"),
+            ("gather_plan", "muse_spark_fp4::gather_plan"),
+            ("combine", "muse_spark_fp4::combine"),
+            ("fused", f"muse_spark_fp4::fused<{args}>"),
+        ],
+        extra_cuda_cflags=["-O3", "--use_fast_math"],
+    )
+
+
+def _row_split_mode(num_tokens: int) -> int:
+    """0: off; 1: four consumer warpgroups (no expert can take over 64 routes); 2: the plan picks them or the two-warpgroup grid when an expert has over 64 routes."""
+    if not _ROW_SPLIT_MIN_TOKENS <= num_tokens <= _ROW_SPLIT_MAX_TOKENS:
+        return 0
+    return 1 if _NARROW_MAX_TOKENS < num_tokens <= 64 else 2
+
+
+def prepare_muse_spark_fp4_grouped_kernel(fast_scale: bool) -> None:
+    """Compile (or load) the kernel for a scale decode at model load, not at capture."""
+    _jit_grouped_moe_module(fast_scale)
+
+
+@triton.jit
+def _grouped_combine_kernel(
+    y_ptr,
+    rrow_ptr,
+    lid_ptr,
+    w_ptr,
+    norm_w_ptr,
+    out_ptr,
+    eps,
+    owner_bases_ptr,
+    slot_row0,
+    rows_per_owner,
+    TOPK: tl.constexpr,
+    H: tl.constexpr,
+    WEIGHT_FIRST: tl.constexpr,
+    PUSH: tl.constexpr,
+):
+    tok = tl.program_id(0)
+    offs = tl.arange(0, H)
+    nw = tl.load(norm_w_ptr + offs).to(tl.float32)
+    acc = tl.zeros([H], dtype=tl.float32)
+    routes = 0
+    for k in tl.static_range(TOPK):
+        routes += (tl.load(lid_ptr + tok * TOPK + k) >= 0).to(tl.int32)
+        if tl.load(lid_ptr + tok * TOPK + k) >= 0:
+            row = tl.load(rrow_ptr + tok * TOPK + k).to(tl.int64)
+            x = tl.load(y_ptr + row * H + offs).to(tl.float32)
+            if WEIGHT_FIRST:
+                y = x * nw
+                var = tl.sum(y * y, axis=0) / H
+                y = y * tl.rsqrt(var + eps)
+            else:
+                var = tl.sum(x * x, axis=0) / H
+                y = x * tl.rsqrt(var + eps) * nw
+            acc += y * tl.load(w_ptr + tok * TOPK + k)
+    if PUSH:
+        # Rows with no local route stay unwritten; the owner's fold reads them as +0.0.
+        owner = tok // rows_per_owner
+        dst = tl.load(owner_bases_ptr + owner).to(tl.pointer_type(tl.bfloat16))
+        row = (slot_row0 + tok - owner * rows_per_owner).to(tl.int64)
+        tl.store(dst + row * H + offs, acc.to(tl.bfloat16), mask=(routes > 0) & (offs < H))
+    else:
+        tl.store(out_ptr + tok.to(tl.int64) * H + offs, acc.to(tl.bfloat16))
+
+
+def _padded_row_bound(num_tokens: int) -> int:
+    """Bound on the local experts' padded rows: ``num_tokens`` routes (distinct top-k ids) plus 63 pad rows per expert; up to 64 tokens one 32/64-row tile is tighter."""
+    if num_tokens <= 32:
+        return _LOCAL_EXPERTS * 32
+    if num_tokens <= 64:
+        return _LOCAL_EXPERTS * 64
+    return num_tokens * _TOP_K + _LOCAL_EXPERTS * 63
+
+
+def muse_spark_fp4_grouped_experts(
+    *,
+    hidden_states: torch.Tensor,
+    topk_ids: torch.Tensor,
+    topk_scores: torch.Tensor,
+    gate_up: torch.Tensor,
+    down: torch.Tensor,
+    gate_up_scale: torch.Tensor,
+    down_scale: torch.Tensor,
+    local_expert_offset: int,
+    fast_scale: bool,
+    pre_norm_weight: torch.Tensor,
+    pre_norm_eps: float,
+    post_norm_weight: torch.Tensor,
+    post_norm_eps: float,
+    post_norm_weight_first: bool,
+    scatter_target: Optional[tuple[torch.Tensor, int, int]] = None,
+) -> Optional[torch.Tensor]:
+    """Routed experts of un-normalized bf16 ``[M, 4096]`` (normed in the gather kernel),
+    global ``topk_ids``; bf16 ``[M, 4096]``, zero rows for tokens with no local route.
+    """
+    num_tokens = hidden_states.shape[0]
+    if num_tokens == 0:
+        return hidden_states.new_zeros((0, _HIDDEN))
+
+    device = hidden_states.device
+    module = _jit_grouped_moe_module(fast_scale)
+    max_rows = _padded_row_bound(num_tokens)
+    max_tiles = num_tokens * _TOP_K // _MIN_TILE_ROWS + _MAX_TILES_SLACK
+    fine = num_tokens >= _FINE_TILES_MIN_TOKENS
+    row_split = _row_split_mode(num_tokens)
+    decode = num_tokens <= _DECODE_MAX_TOKENS
+
+    counters = (torch.empty if decode else torch.zeros)(
+        _LOCAL_EXPERTS + 2 + max_tiles, dtype=torch.int32, device=device
+    )
+    route_counts = counters[:_LOCAL_EXPERTS]
+    work_counter = counters[_LOCAL_EXPERTS : _LOCAL_EXPERTS + 2]
+    tile_done = counters[_LOCAL_EXPERTS + 2 :]
+
+    local_ids = torch.empty((num_tokens, _TOP_K), dtype=torch.int32, device=device)
+    route_pos = torch.empty((num_tokens, _TOP_K), dtype=torch.int32, device=device)
+    route_rows = torch.empty((num_tokens, _TOP_K), dtype=torch.int32, device=device)
+    tiles = torch.empty((max_tiles, 4), dtype=torch.int32, device=device)
+    num_tiles = torch.empty((2,), dtype=torch.int32, device=device)
+    xt = torch.empty((max_rows, _HIDDEN), dtype=torch.bfloat16, device=device)
+    inter = torch.empty((max_rows, _HIDDEN), dtype=torch.bfloat16, device=device)
+    pairs = scatter_target is not None and scatter_target[1] is None
+    if pairs and not fine:
+        raise ValueError("pair-row stores need the fine-tile kernel (>= 512 tokens)")
+    y = inter if pairs else torch.empty((max_rows, _HIDDEN), dtype=torch.bfloat16, device=device)
+    row_dst = torch.empty((max_rows,), dtype=torch.int64, device=device) if pairs else route_rows
+
+    if decode:
+        module.route_pairs_one_block(
+            topk_ids.to(torch.int32).contiguous(),
+            local_expert_offset,
+            local_ids,
+            route_pos,
+            route_counts,
+            counters[_LOCAL_EXPERTS:],
+        )
+    else:
+        module.route_pairs(
+            topk_ids.to(torch.int32).contiguous(),
+            local_expert_offset,
+            local_ids,
+            route_pos,
+            route_counts,
+        )
+    module.gather_plan(
+        hidden_states.contiguous(),
+        pre_norm_weight,
+        local_ids,
+        route_pos,
+        route_counts,
+        xt,
+        route_rows,
+        tiles,
+        num_tiles,
+        pre_norm_eps,
+        2 if row_split else fine,
+        row_dst,
+        scatter_target[0] if pairs else route_rows,
+        scatter_target[2] if pairs else 0,
+    )
+    module.fused(
+        gate_up,
+        down,
+        xt,
+        inter,
+        y,
+        tiles,
+        num_tiles,
+        gate_up_scale,
+        down_scale,
+        work_counter,
+        tile_done,
+        fine,
+        row_split,
+        num_tokens <= _NARROW_MAX_TOKENS,
+        row_dst,
+        pairs,
+    )
+    if pairs:
+        return None
+
+    push = scatter_target is not None
+    out = (
+        y
+        if push
+        else torch.empty((num_tokens, _HIDDEN), dtype=torch.bfloat16, device=device)
+    )
+    if decode and not push:
+        module.combine(
+            y,
+            route_rows,
+            local_ids,
+            topk_scores.to(torch.float32).contiguous(),
+            post_norm_weight,
+            out,
+            post_norm_eps,
+            post_norm_weight_first,
+        )
+        return out
+    owner_bases, slot_row0, rows_per_owner = scatter_target if push else (out, 0, 1)
+    _grouped_combine_kernel[(num_tokens,)](
+        y,
+        route_rows,
+        local_ids,
+        topk_scores.to(torch.float32).contiguous(),
+        post_norm_weight,
+        out,
+        post_norm_eps,
+        owner_bases,
+        slot_row0,
+        rows_per_owner,
+        TOPK=_TOP_K,
+        H=_HIDDEN,
+        WEIGHT_FIRST=post_norm_weight_first,
+        PUSH=push,
+        num_warps=8,
+        num_stages=2,
+    )
+    return None if push else out
