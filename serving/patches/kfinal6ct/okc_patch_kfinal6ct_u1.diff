diff --git a/python/sglang/srt/layers/attention/fa3_verify_schedule.py b/python/sglang/srt/layers/attention/fa3_verify_schedule.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/srt/layers/attention/fa3_verify_schedule.py
@@ -0,0 +1,248 @@
+"""One FA3 tile schedule per target-verify step, shared by every layer, with a
+split-KV count chosen against wave quantization.
+
+Layers with the same window read the same lengths, so ``get_scheduler_metadata``
+runs once per step and every call takes it as ``scheduler_metadata``. Where FA3's
+own split counts leave over a quarter of the last wave idle, a cost model picks one
+tile length per step and each request gets the splits its length needs
+(``plan_splits`` per captured batch size, ``write_splits`` on device); only the
+split-KV merge order changes. Under CUDA graphs the schedule is rebuilt eagerly
+before each replay into capture-stable buffers.
+"""
+
+from __future__ import annotations
+
+import math
+from typing import Callable, NamedTuple, Optional
+
+import torch
+import triton
+import triton.language as tl
+
+FULL_WINDOW = (-1, -1)
+
+# Cost model of one split-KV tile: (kv units in the tile + SPLIT_OVERHEAD_UNITS), one
+# tile per SM per wave. Fitted on SM90, FP8 KV, head dim 64, 8 query rows x 8 heads
+# per kv head with a split-KV microbenchmark; re-fit for other shapes.
+SPLIT_UNIT_TOKENS = 128
+SPLIT_OVERHEAD_UNITS = 2.2
+SPLIT_TOLERANCE = 1.05
+MIN_TILE_UNITS = 2
+KEEP_FA3_WAVE_FILL = 0.75
+MAX_SPLITS = 128
+
+
+class SplitPlan(NamedTuple):
+    num_splits: int  # static bound the FA3 call is built with
+    max_units: int
+    num_kv_heads: int
+    num_sms: int
+    sorted_batches: bool
+
+
+class VerifySchedule(NamedTuple):
+    metadata: torch.Tensor
+    num_splits: int
+
+
+def verify_windows(*, sliding_window_size: Optional[int]) -> list:
+    windows = [FULL_WINDOW]
+    if sliding_window_size is not None and sliding_window_size > -1:
+        windows.append((sliding_window_size, 0))
+    return windows
+
+
+def alloc_verify_schedule_bufs(
+    *, windows: list, max_bs: int, device: torch.device
+) -> dict:
+    size = 1 + ((max_bs + 3) // 4) * 4 * 4
+    return {w: torch.zeros(size, dtype=torch.int32, device=device) for w in windows}
+
+
+def window_max_tokens(
+    *, window: tuple, num_tokens_per_req: int, max_seqlen_k: int
+) -> int:
+    if window == FULL_WINDOW:
+        return max_seqlen_k
+    return min(max_seqlen_k, window[0] + 1 + num_tokens_per_req + SPLIT_UNIT_TOKENS)
+
+
+def _ceil_div(a, b):
+    return torch.div(a + b - 1, b, rounding_mode="floor")
+
+
+def _split_choice(*, units, candidates, num_kv_heads: int, num_sms: int):
+    """units [bs] int64 (kv units per request); candidates [S] int64 (splits of the longest request)."""
+    tile = _ceil_div(units.max().clamp(min=1), candidates)
+    per_req = _ceil_div(units[:, None], tile[None, :]).clamp(min=1)
+    too_small = (tile < MIN_TILE_UNITS) & (candidates > 1)
+    tile_cost = tile.to(torch.float32) + SPLIT_OVERHEAD_UNITS
+    share = (units[:, None].to(torch.float32) + SPLIT_OVERHEAD_UNITS) / tile_cost[None, :]
+    tiles = torch.where(per_req >= 2, per_req.to(torch.float32), share).sum(dim=0)
+    times = torch.ceil(tiles * num_kv_heads / num_sms - 1e-3) * tile_cost
+    times = times.masked_fill(too_small, float("inf"))
+    pick = (times <= times.min() * SPLIT_TOLERANCE).int().argmax()
+    return per_req, pick
+
+
+def plan_splits(
+    *, bs: int, num_kv_heads: int, num_sms: int, max_tokens: int, sorted_batches: bool
+) -> SplitPlan:
+    """Static split bound for a captured batch size: the policy's choice when every request is as long as the window (or the context limit) allows."""
+    max_units = max(1, math.ceil(max_tokens / SPLIT_UNIT_TOKENS))
+    limit = min(MAX_SPLITS, max(1, max_units // MIN_TILE_UNITS))
+    candidates = torch.arange(1, limit + 1)
+    units = torch.full((bs,), max_units)
+    _, pick = _split_choice(
+        units=units, candidates=candidates, num_kv_heads=num_kv_heads, num_sms=num_sms
+    )
+    num_splits = int(pick) + 1
+    return SplitPlan(
+        num_splits=num_splits,
+        max_units=max_units,
+        num_kv_heads=num_kv_heads,
+        num_sms=num_sms,
+        sorted_batches=sorted_batches,
+    )
+
+
+@triton.jit
+def _write_splits_kernel(
+    schedule_ptr,
+    seqlens_ptr,
+    bs,
+    order_offset,
+    num_splits,
+    max_tokens,
+    num_kv_heads,
+    num_sms,
+    SORTED: tl.constexpr,
+    BLOCK_B: tl.constexpr,
+    BLOCK_S: tl.constexpr,
+    UNIT: tl.constexpr,
+    OVERHEAD: tl.constexpr,
+    TOLERANCE: tl.constexpr,
+    MIN_TILE: tl.constexpr,
+    KEEP_FILL: tl.constexpr,
+    MIN_SPLITS: tl.constexpr = 1,
+):
+    rows = tl.arange(0, BLOCK_B)
+    row_ok = rows < bs
+    seq = tl.load(seqlens_ptr + rows, mask=row_ok, other=0).to(tl.int64)
+    units = tl.maximum((tl.minimum(seq, max_tokens) + UNIT - 1) // UNIT, 1)
+    units = tl.where(row_ok, units, 0)
+    longest = tl.maximum(tl.max(units, axis=0), 1)
+    cand = tl.arange(0, BLOCK_S) + 1
+    cand_ok = cand <= num_splits
+    tile = (longest + cand - 1) // cand
+    per_req = tl.maximum((units[:, None] + tile[None, :] - 1) // tile[None, :], 1)
+    tile_cost = tile.to(tl.float32) + OVERHEAD
+    share = (units[:, None].to(tl.float32) + OVERHEAD) / tile_cost[None, :]
+    count = tl.where(per_req >= 2, per_req.to(tl.float32), share)
+    tiles = tl.sum(tl.where(row_ok[:, None], count, 0.0), axis=0)
+    times = tl.ceil(tiles * num_kv_heads / num_sms - 1e-3) * tile_cost
+    bad = (cand_ok == 0) | ((tile < MIN_TILE) & (cand > 1))
+    times = tl.where(bad, float("inf"), times)
+    ok = (times <= tl.min(times, axis=0) * TOLERANCE) & (bad == 0)
+    pick = tl.min(tl.where(ok, cand, BLOCK_S + 1), axis=0)
+    pick_tile = (longest + pick - 1) // pick
+    if SORTED:
+        req = tl.load(schedule_ptr + order_offset + rows, mask=row_ok, other=0)
+        req = tl.minimum(tl.maximum(req, 0), bs - 1)
+        seq_v = tl.load(seqlens_ptr + req, mask=row_ok, other=0).to(tl.int64)
+        units = tl.maximum((tl.minimum(seq_v, max_tokens) + UNIT - 1) // UNIT, 1)
+        units = tl.where(row_ok, units, 1)
+    else:
+        units = tl.where(row_ok, units, 1)
+    ours = tl.maximum((units + pick_tile - 1) // pick_tile, 1)
+    fa3 = tl.load(schedule_ptr + rows, mask=row_ok, other=1).to(tl.int64)
+    fa3 = tl.minimum(tl.maximum(fa3, 1), num_splits)
+    fa3 = (units + (units + fa3 - 1) // fa3 - 1) // ((units + fa3 - 1) // fa3)
+    fa3_tile = units.to(tl.float32) / fa3.to(tl.float32)
+    fa3_tile = tl.where(row_ok, fa3_tile, 0.0)
+    big = fa3_tile >= 0.75 * tl.max(fa3_tile, axis=0)
+    fa3_tiles = tl.sum(tl.where(big & row_ok, fa3, 0), axis=0) * num_kv_heads
+    fill = fa3_tiles.to(tl.float32) / (((fa3_tiles + num_sms - 1) // num_sms) * num_sms).to(tl.float32)
+    kept = tl.load(schedule_ptr + rows, mask=row_ok, other=1).to(tl.int64)
+    kept = tl.minimum(tl.maximum(kept, 1), num_splits)
+    final = tl.maximum(tl.where(fill >= KEEP_FILL, kept, ours), MIN_SPLITS)
+    tl.store(schedule_ptr + rows, final.to(tl.int32), mask=row_ok)
+
+
+def write_splits(
+    *, schedule: torch.Tensor, cache_seqlens: torch.Tensor, plan: SplitPlan, min_splits: int = 1
+) -> None:
+    """Each request's split count for this step, from the live lengths, into the schedule's first vector (one kernel; no host sync)."""
+    bs = cache_seqlens.shape[0]
+    _write_splits_kernel[(1,)](
+        schedule,
+        cache_seqlens,
+        bs,
+        2 * ((bs + 3) // 4 * 4),
+        plan.num_splits,
+        plan.max_units * SPLIT_UNIT_TOKENS,
+        plan.num_kv_heads,
+        plan.num_sms,
+        SORTED=plan.sorted_batches,
+        BLOCK_B=max(16, triton.next_power_of_2(bs)),
+        BLOCK_S=max(16, triton.next_power_of_2(plan.num_splits)),
+        UNIT=SPLIT_UNIT_TOKENS,
+        OVERHEAD=SPLIT_OVERHEAD_UNITS,
+        TOLERANCE=SPLIT_TOLERANCE,
+        MIN_TILE=MIN_TILE_UNITS,
+        KEEP_FILL=KEEP_FA3_WAVE_FILL,
+        MIN_SPLITS=min_splits,
+    )
+
+
+def fill_verify_schedules(
+    *,
+    bufs: dict,
+    plans: Optional[dict],
+    build_schedule: Callable[..., torch.Tensor],
+    bs: int,
+    num_tokens_per_req: int,
+    max_seqlen_k: int,
+    cache_seqlens: torch.Tensor,
+    cu_seqlens_q: torch.Tensor,
+    num_splits: int,
+    **fixed,
+) -> Optional[dict]:
+    """``max_seqlen_k`` and ``num_splits`` must be what the forward call passes (page-table width x page size, and its num_splits), so the static split bound FA3 derives from them is the forward call's."""
+    if not bufs:
+        return None
+    schedules = {}
+    for window, buf in bufs.items():
+        plan = plans[window] if plans is not None else None
+        splits = plan.num_splits if plan is not None else num_splits
+        schedule = build_schedule(
+            batch_size=bs,
+            max_seqlen_q=num_tokens_per_req,
+            max_seqlen_k=max_seqlen_k,
+            cache_seqlens=cache_seqlens,
+            cu_seqlens_q=cu_seqlens_q,
+            causal=True,
+            window_size=window,
+            num_splits=splits,
+            **fixed,
+        )
+        n = schedule.shape[0]
+        buf[:n].copy_(schedule)
+        if plan is not None:
+            write_splits(schedule=buf, cache_seqlens=cache_seqlens[:bs], plan=plan)
+        schedules[window] = VerifySchedule(metadata=buf[:n], num_splits=splits)
+    return schedules
+
+
+def select_verify_schedule(
+    *,
+    schedules: Optional[dict],
+    window_size: tuple,
+    causal: bool,
+    layer_shape: tuple,
+    schedule_shape: tuple,
+) -> Optional[VerifySchedule]:
+    """The shared schedule for a layer call, or None when the call differs from the one the schedule was built for (heads, head dims, softcap, window, causality)."""
+    if schedules is None or not causal or layer_shape != schedule_shape:
+        return None
+    return schedules.get(tuple(window_size))
diff --git a/python/sglang/srt/layers/attention/fa3_verify_tree.py b/python/sglang/srt/layers/attention/fa3_verify_tree.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/srt/layers/attention/fa3_verify_tree.py
@@ -0,0 +1,197 @@
+"""Tree-masked DFLASH target verify: rows 6-7 of a request may be a branch that
+does not see chain rows e..5 (branch slot e, 0 = plain chain).
+
+The prefix call attends every verify row over the old prefix only (non-causal over the p old
+keys; sliding-window rows get window (w - 8, 7)) and returns FP32 split partials: the Muse FP8
+prefix kernel (one split per non-empty key range) for e4m3 q and 2 x 64 KV, else FA3 forced to >= 2 splits. One
+kernel per layer attends each row over its <= 8 remaining keys and merges them with those
+partials in FP32 (muse_spark_verify_tree). Only the key partition (summation order) differs
+from one causal FA3 call over the row's key set.
+"""
+
+from __future__ import annotations
+
+from typing import NamedTuple, Optional
+
+import torch
+
+from sglang.srt.layers.attention import fa3_verify_schedule
+from sglang.srt.layers.attention.fa3_verify_schedule import FULL_WINDOW, VerifySchedule
+
+ROWS = 8
+
+
+class VerifyTree(NamedTuple):
+    prefix_lens: torch.Tensor  # int32 [bs]
+    table: torch.Tensor  # int32 [8 bs, 8] full-pool correction slots
+    swa_table: Optional[torch.Tensor]
+    schedules: dict  # keys: the tree windows this forward serves
+    build: Optional[object] = None  # tree window -> its FA3 VerifySchedule, built at each FA3 call (captured with it)
+
+
+def tree_window(window_size: tuple) -> tuple:
+    """The prefix call's window for a layer's stock verify window."""
+    return FULL_WINDOW if window_size[0] < 0 else (window_size[0] - ROWS, ROWS - 1)
+
+
+class VerifyTreeBuffers:
+    """Capture-stable tables and schedules of the tree verify, sized for max_bs."""
+
+    def __init__(self, *, max_bs: int, windows: list, device):
+        self.prefix_lens = torch.zeros(max_bs, dtype=torch.int32, device=device)
+        self.branch_slot = torch.zeros(max_bs, dtype=torch.int32, device=device)
+        self.loc = torch.zeros(max_bs * ROWS, dtype=torch.int64, device=device)
+        self.table = torch.full((max_bs * ROWS, 8), -1, dtype=torch.int32, device=device)
+        self.swa_table = torch.full_like(self.table, -1)
+        self.schedule_bufs = fa3_verify_schedule.alloc_verify_schedule_bufs(
+            windows=[tree_window(w) for w in windows], max_bs=max_bs, device=device
+        )
+
+
+def fill_verify_tree(
+    *,
+    bufs: VerifyTreeBuffers,
+    bs: int,
+    seq_lens: torch.Tensor,
+    branch_slot: Optional[torch.Tensor],
+    out_cache_loc: torch.Tensor,
+    page_table: torch.Tensor,
+    swa_page_table: Optional[torch.Tensor],
+    swa_out_cache_loc: Optional[torch.Tensor],
+    sliding_window: Optional[int],
+    cu_seqlens_q: torch.Tensor,
+    plans: Optional[dict],
+    build_schedule,
+    **fixed,
+) -> VerifyTree:
+    """Tables and split schedules of one verify forward (device-side, no sync)."""
+    from sglang.kernels.ops.attention.muse_spark_verify_tree import build_tables
+
+    prefix = bufs.prefix_lens[:bs]
+    prefix.copy_(seq_lens[:bs])
+    slot = bufs.branch_slot[:bs]
+    if branch_slot is None:
+        slot.zero_()
+    else:
+        n = min(bs, branch_slot.numel())
+        slot[:n].copy_(branch_slot[:n])
+        slot[n:].zero_()
+    loc = bufs.loc[: bs * ROWS]
+    n = min(loc.numel(), out_cache_loc.numel())
+    loc[:n].copy_(out_cache_loc[:n])
+    loc[n:].zero_()
+    table = bufs.table[: bs * ROWS]
+    swa_table = bufs.swa_table[: bs * ROWS] if swa_page_table is not None else None
+    build_tables(
+        seq_lens=prefix,
+        branch_slot=slot,
+        page_table=page_table[:bs],
+        out_cache_loc=loc,
+        table=table,
+        window=sliding_window if sliding_window is not None else -1,
+        swa_page_table=None if swa_page_table is None else swa_page_table[:bs],
+        swa_out_cache_loc=(
+            None if swa_page_table is None else swa_out_cache_loc[: bs * ROWS]
+        ),
+        swa_table=swa_table,
+    )
+    max_seqlen_k = page_table.shape[1]
+    plans = {tree_window(w): plan for w, plan in (plans or {}).items()}
+    schedules = dict.fromkeys(plans)
+
+    def build(window):  # FA3's tree schedule, only for a layer the prefix kernel did not serve
+        plan, buf = plans[window], bufs.schedule_bufs[window]
+        splits = max(plan.num_splits, 2)
+        schedule = build_schedule(
+            batch_size=bs,
+            max_seqlen_q=ROWS,
+            max_seqlen_k=max_seqlen_k,
+            cache_seqlens=prefix,
+            cu_seqlens_q=cu_seqlens_q,
+            causal=False,
+            window_size=window,
+            num_splits=splits,
+            **fixed,
+        )
+        m = schedule.shape[0]
+        buf[:m].copy_(schedule)
+        # min 2: FA3 writes a one-split request straight to bf16 and leaves its partials stale.
+        fa3_verify_schedule.write_splits(
+            schedule=buf, cache_seqlens=prefix, plan=plan._replace(num_splits=splits), min_splits=2
+        )
+        return VerifySchedule(metadata=buf[:m], num_splits=splits)
+
+    return VerifyTree(prefix_lens=prefix, table=table, swa_table=swa_table, schedules=schedules, build=build)
+
+
+def tree_verify_attention(
+    *,
+    flash_attn_with_kvcache,
+    tree: VerifyTree,
+    q: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    page_table: torch.Tensor,
+    cu_seqlens_q: torch.Tensor,
+    window_size: tuple,
+    softmax_scale: float,
+    out: Optional[torch.Tensor],
+    ver: int,
+    descale: dict,
+    k_scale: float,
+    v_scale: float,
+) -> Optional[torch.Tensor]:
+    from sglang.kernels.ops.attention.muse_spark_verify_tree import correct
+
+    window = tree_window(window_size)
+    table = tree.table if window == FULL_WINDOW else tree.swa_table
+    if window not in tree.schedules or table is None:
+        return None  # a window the tree was not built for: the stock call serves the layer
+    if (
+        q.dtype == key_cache.dtype == torch.float8_e4m3fn
+        and key_cache.shape[-2:] == (2, 64)
+        and (window == FULL_WINDOW or window[0] > 0)  # the kernel reads window 0 as full attention
+    ):
+        from sglang.kernels.ops.attention.muse_spark_verify_tree import prefix_verify
+
+        # Catches the JIT load and host-side shape / dtype checks, which run before any write to out: one path serves the layer.
+        try:  # FA3 below serves the layer if the prefix kernel cannot
+            return prefix_verify(q=q, k_cache=key_cache, v_cache=value_cache, page_table=page_table,
+                                 prefix_lens=tree.prefix_lens, table=table, softmax_scale=softmax_scale, k_scale=k_scale,
+                                 v_scale=v_scale, window=max(window[0], 0), out=torch.empty(q.shape, dtype=torch.bfloat16, device=q.device) if out is None else out)
+        except Exception:  # noqa: BLE001
+            pass
+    schedule = tree.build(window)
+    res = flash_attn_with_kvcache(
+        q=q,
+        k_cache=key_cache,
+        v_cache=value_cache,
+        page_table=page_table,
+        cache_seqlens=tree.prefix_lens,
+        cu_seqlens_q=cu_seqlens_q,
+        max_seqlen_q=ROWS,
+        softmax_scale=softmax_scale,
+        causal=False,
+        window_size=window,
+        return_softmax_lse=True,
+        num_splits=schedule.num_splits,
+        scheduler_metadata=schedule.metadata,
+        out=out,
+        ver=ver,
+        **descale,
+    )
+    o, out_partial, lse_partial = res[0], res[2], res[3]
+    return correct(
+        q=q,
+        k_cache=key_cache,
+        v_cache=value_cache,
+        table=table,
+        out_partial=out_partial,
+        lse_partial=lse_partial,
+        scheduler_metadata=schedule.metadata,
+        sorted_batches=window == FULL_WINDOW,
+        out=o,
+        softmax_scale=softmax_scale,
+        k_scale=k_scale,
+        v_scale=v_scale,
+    )
