+template <int FINE, bool kFastScale, int kSlots = NSLOT, int kSlotBytes = SLOT, int kWG = 2>
+__global__ void __launch_bounds__(128 * (kWG + 1), 1) moe_fused_persistent(FusedArgs fa) {
