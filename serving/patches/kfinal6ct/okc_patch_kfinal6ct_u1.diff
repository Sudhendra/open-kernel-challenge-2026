--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/muse_spark_online_placement.py
@@ -0,0 +1,392 @@
+"""Online expert placement for Muse Spark EP: count the run's own routing, fit once, move experts between forwards."""
+
+from __future__ import annotations
+
+import logging
+import zlib
+from typing import List, Optional, Sequence, Tuple
+
+import torch
+import torch.distributed as dist
+import triton
+import triton.language as tl
+
+from sglang.srt.layers.muse_spark import muse_spark_online_placement_plan as plan
+
+logger = logging.getLogger(__name__)
+
+# Layer code at the switch: 0 / 1 grouped NVFP4 with the fast / exact scale decode, 2 not movable.
+_INELIGIBLE = 2
+
+
+def _capturing() -> bool:
+    from sglang.srt.model_executor.runner_utils.capture_mode import get_is_capture_mode
+    from sglang.srt.runtime_context import get_flags
+
+    return (
+        get_is_capture_mode()
+        or get_flags().dp.capturing_prefill_graph
+        or (torch.cuda.is_available() and torch.cuda.is_current_stream_capturing())
+    )
+
+
+def _is_prefill(forward_mode) -> bool:
+    return forward_mode.is_extend() and not forward_mode.is_target_verify()
+
+
+def _prefill_rows(forward_batch) -> int:
+    if forward_batch.extend_num_tokens is not None:
+        return int(forward_batch.extend_num_tokens)
+    return int(forward_batch.input_ids.shape[0])
+
+
+def moe_row_bound() -> Optional[torch.Tensor]:
+    """Device count of the real rows of this forward's MoE input (live under graph replay), or None."""
+    from sglang.srt.model_executor.forward_context import (
+        get_forward_context,
+        has_forward_context,
+    )
+
+    if not has_forward_context():
+        return None
+    get_bound = get_forward_context().moe_num_token_non_padded
+    return None if get_bound is None else get_bound()
+
+
+@triton.jit
+def _count_routes_kernel(
+    counts_ptr,
+    enable_ptr,
+    ids_ptr,
+    bound_ptr,
+    numel,
+    TOPK: tl.constexpr,
+    EXPERTS: tl.constexpr,
+    BINS: tl.constexpr,
+    HAS_BOUND: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    enable = tl.load(enable_ptr)
+    if enable != 0:
+        offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+        ids = tl.load(ids_ptr + offs, mask=offs < numel, other=-1).to(tl.int32)
+        keep = (offs < numel) & (ids >= 0)
+        if HAS_BOUND:
+            keep = keep & (offs // TOPK < tl.load(bound_ptr).to(tl.int32))
+        hist = tl.histogram(tl.where(keep, ids, EXPERTS), BINS)
+        bins = tl.arange(0, BINS)
+        # Integer adds: the same counts as the per-pair index_add in any order.
+        tl.atomic_add(counts_ptr + bins, hist.to(tl.int64) * enable, mask=(bins < EXPERTS) & (hist > 0))
+
+
+def count_routes(
+    counts: torch.Tensor,
+    enable: torch.Tensor,
+    topk_ids: torch.Tensor,
+    bound: Optional[torch.Tensor],
+) -> None:
+    """``counts[e] += enable`` per (row < bound, k) pair routed to physical expert e; device ops, capturable."""
+    rows = topk_ids.shape[0]
+    if topk_ids.is_cuda and rows:
+        ids = topk_ids.reshape(-1)
+        block = 4096
+        _count_routes_kernel[(triton.cdiv(ids.numel(), block),)](
+            counts,
+            enable,
+            ids,
+            ids if bound is None else bound,
+            ids.numel(),
+            TOPK=ids.numel() // rows,
+            EXPERTS=counts.numel(),
+            BINS=triton.next_power_of_2(counts.numel() + 1),
+            HAS_BOUND=bound is not None,
+            BLOCK=block,
+        )
+        return
+    ids = topk_ids.reshape(rows, -1).long()
+    weight = enable.expand(rows)
+    if bound is not None:
+        weight = weight * (torch.arange(rows, device=ids.device) < bound.reshape(-1)[:1])
+    weight = (weight.unsqueeze(1) * (ids >= 0)).reshape(-1)
+    counts.index_add_(0, ids.clamp(min=0).reshape(-1), weight)
+
+
+class OnlinePlacement:
+    """Model-level controller: one histogram per eligible layer, the trigger, the fit and the mover."""
+
+    def __init__(
+        self,
+        layers: Sequence[torch.nn.Module],
+        *,
+        group,
+        ep_size: int,
+        rows_to_switch: int,
+        min_gain: Optional[float] = None,
+        layers_per_step: Optional[int] = None,
+    ):
+        self.layers = list(layers)
+        self.group = group
+        self.ep_size = ep_size
+        self.rank = group.rank_in_group
+        self.rows_to_switch = rows_to_switch
+        # Fit weight of prefill load vs decode hit chance; 1.0 balances prefill only.
+        self.alpha = 0.5
+        self.min_gain = 0.02 if min_gain is None else min_gain
+        self.stay_slack = 0.02
+        self.layers_per_step = max(1, 4 if layers_per_step is None else layers_per_step)
+        num_experts = self.layers[0].num_experts
+        device = self.layers[0].expert_l2p.device
+        self.device = device
+        self.counts = torch.zeros((len(self.layers), num_experts), dtype=torch.int64, device=device)
+        self.count_enable = torch.zeros((1,), dtype=torch.int64, device=device)
+        self._enable_value = 0
+        self.p2l: List[torch.Tensor] = [
+            layer.expert_p2l_dev.detach().to("cpu", torch.int64) for layer in self.layers
+        ]
+        for i, layer in enumerate(self.layers):
+            layer.bind_route_counts(self.counts[i], self.count_enable, self)
+        self.counting = True
+        self.armed = False
+        self.done = False
+        self.rows_seen = 0
+        self.pending: List[Tuple[int, List[plan.Round], torch.Tensor, torch.Tensor]] = []
+        self._staging: Optional[torch.Tensor] = None
+        self._stats = {"layers": 0, "rounds": 0, "moved": 0, "forwards": 0}
+
+    def banner(self) -> str:
+        return (
+            f"Muse online expert placement enabled: {len(self.layers)} layers, switch after "
+            f"{self.rows_to_switch} prefill rows, alpha {self.alpha}, min gain {self.min_gain}, "
+            f"stay slack {self.stay_slack}, {self.layers_per_step} layers per forward"
+        )
+
+    def before_forward(self, forward_batch) -> None:
+        if self.done:
+            return
+        if _capturing():
+            self._set_enable(0)
+            return
+        mode = forward_batch.forward_mode
+        if not self.armed:
+            if mode.is_decode() or mode.is_target_verify():
+                self.armed = True
+                if self.rank == 0:
+                    logger.warning(
+                        "Muse online expert placement armed: counting prefill routes until %d rows",
+                        self.rows_to_switch,
+                    )
+            return
+        if self.pending:
+            self._move_next_layers()
+            return
+        if not _is_prefill(mode):
+            return
+        if self.rows_seen >= self.rows_to_switch:
+            self._set_enable(0)
+            self.counting = False
+            self._fit_and_plan()
+            if not self.done:  # nothing to move finishes inside the fit
+                self._move_next_layers()
+            return
+        self.rows_seen += _prefill_rows(forward_batch)
+        self._set_enable(1)
+
+    def _set_enable(self, value: int) -> None:
+        if value != self._enable_value:
+            self.count_enable.fill_(value)
+            self._enable_value = value
+
+    def _layer_codes(self) -> torch.Tensor:
+        """0 / 1: grouped NVFP4 with the fast / exact scale decode; 2: not movable on this rank."""
+        codes = []
+        for layer in self.layers:
+            experts = layer.experts
+            if not experts.use_grouped_fp4:
+                codes.append(_INELIGIBLE)
+            else:
+                codes.append(0 if experts.grouped_fp4_fast_scale else 1)
+        return torch.tensor(codes, dtype=torch.int64)
+
+    def _fit_and_plan(self) -> None:
+        lo, hi = self._layer_codes(), self._layer_codes()
+        dist.all_reduce(lo, op=dist.ReduceOp.MIN, group=self.group.cpu_group)
+        dist.all_reduce(hi, op=dist.ReduceOp.MAX, group=self.group.cpu_group)
+        movable = (lo == hi) & (hi < _INELIGIBLE)
+        num_experts = self.counts.shape[1]
+        new_rank = torch.full((len(self.layers), num_experts), -1, dtype=torch.int64)
+        if self.rank == 0:
+            physical = self.counts.cpu()
+            for i in range(len(self.layers)):
+                if not bool(movable[i]):
+                    continue
+                logical = torch.empty_like(physical[i])
+                logical[self.p2l[i]] = physical[i]
+                fitted = plan.fit_layer(
+                    logical,
+                    self.p2l[i],
+                    ep_size=self.ep_size,
+                    top_k=self.layers[i].top_k,
+                    alpha=self.alpha,
+                    min_gain=self.min_gain,
+                    stay_slack=self.stay_slack,
+                )
+                if fitted is not None:
+                    new_rank[i] = fitted
+        dist.broadcast(new_rank, src=self.group.ranks[0], group=self.group.cpu_group)
+        planned = []
+        for i in range(len(self.layers)):
+            if int(new_rank[i, 0]) >= 0:
+                rounds, p2l = plan.plan_moves(self.p2l[i], new_rank[i], self.ep_size)
+                planned.append((i, rounds, p2l))
+        if planned:
+            tables = torch.stack(
+                [torch.stack((p2l, plan.invert(p2l))) for _, _, p2l in planned]
+            ).to(self.device, torch.int32)
+            self.pending = [
+                (i, rounds, p2l, tables[j]) for j, (i, rounds, p2l) in enumerate(planned)
+            ]
+        if self.rank == 0:
+            logger.warning(
+                "Muse online expert placement switching after %d prefill rows: %d of %d layers re-placed, "
+                "%d all-gather rounds, %d layers per forward",
+                self.rows_seen,
+                len(self.pending),
+                len(self.layers),
+                sum(len(r) for _, r, _, _ in self.pending),
+                self.layers_per_step,
+            )
+        if not self.pending:
+            self._finish()
+
+    def _move_next_layers(self) -> None:
+        with torch.no_grad():
+            for _ in range(min(self.layers_per_step, len(self.pending))):
+                i, rounds, p2l, table = self.pending.pop(0)
+                self._move_layer(self.layers[i], rounds)
+                self.layers[i].set_expert_placement(table[0], table[1])
+                self.p2l[i] = p2l
+                self._stats["layers"] += 1
+                self._stats["rounds"] += len(rounds)
+                self._stats["moved"] += sum(1 for step in rounds for r, _, _ in step if r == self.rank)
+        self._stats["forwards"] += 1
+        if not self.pending:
+            self._finish()
+
+    def _staging_buffer(self, slot_bytes: int, device: torch.device) -> torch.Tensor:
+        need = slot_bytes * self.ep_size
+        if self._staging is None or self._staging.numel() < need:
+            self._staging = torch.empty((need,), dtype=torch.uint8, device=device)
+        return self._staging[:need]
+
+    def _gather_slot(self, tensor: torch.Tensor, slot: int, src: Optional[int]) -> None:
+        """All-gather ``tensor[slot]`` of every rank; if ``src`` is set, refill our slot with rank ``src``'s."""
+        piece = tensor[slot].reshape(-1)
+        nbytes = piece.numel() * piece.element_size()
+        buf = self._staging_buffer(nbytes, tensor.device).view(tensor.dtype)
+        self.group.all_gather_into_tensor(buf, piece.contiguous())
+        if src is not None:
+            n = piece.numel()
+            tensor[slot].reshape(-1).copy_(buf[src * n : (src + 1) * n])
+
+    def _move_layer(self, layer: torch.nn.Module, rounds: List[plan.Round]) -> None:
+        experts = layer.experts
+        tensors = (
+            experts.grouped_gate_up,
+            experts.grouped_down,
+            experts.grouped_gate_up_scale,
+            experts.grouped_down_scale,
+        )
+        first_physical = self.rank * tensors[0].shape[0]
+        for step in rounds:
+            mine = next(
+                ((slot - first_physical, src) for r, slot, src in step if r == self.rank),
+                None,
+            )
+            slot, src = mine if mine is not None else (0, None)
+            for tensor in tensors:
+                self._gather_slot(tensor.data, slot, src)
+
+    def _finish(self) -> None:
+        self.pending = []
+        self._staging = None
+        self.done = True
+        message = (
+            "Muse online expert placement done: %d layers moved, %d all-gather rounds over %d forwards, "
+            "%d experts received by rank %d, table crc32 %08x"
+        )
+        stats = self._stats
+        args = (stats["layers"], stats["rounds"], stats["forwards"], stats["moved"], self.rank, self.table_checksum())
+        log = logger.warning if self.rank == 0 else logger.info
+        log(message, *args)
+
+    def table_checksum(self) -> int:
+        """crc32 of every layer's physical -> logical table: the same on every rank after the switch."""
+        return zlib.crc32(torch.stack(self.p2l).to(torch.int64).numpy().tobytes())
+
+
+def _parallel_value(parallel, name: str, default):
+    try:
+        return getattr(parallel, name)
+    except (AttributeError, RuntimeError, ValueError):
+        return default
+
+
+def unsupported_layout_reason(parallel, group) -> Optional[str]:
+    """Why placement must stay off, or None: all ranks must run the same batches and EP rank r be TP rank r."""
+    if _parallel_value(parallel, "pp_size", 1) != 1:
+        return "pipeline parallelism"
+    if _parallel_value(parallel, "attn_dp_size", 1) != 1:
+        return "DP attention (ranks run different batches)"
+    if _parallel_value(parallel, "attn_cp_size", 1) != 1:
+        return "attention context parallelism"
+    if _parallel_value(parallel, "moe_tp_size", 1) != 1:
+        return "expert tensor parallelism"
+    if (
+        _parallel_value(parallel, "moe_ep_size", 1) != group.world_size
+        or _parallel_value(parallel, "moe_ep_rank", -1) != group.rank_in_group
+    ):
+        return "the EP group is not the TP group"
+    try:
+        from sglang.srt.runtime_context import get_exec
+
+        if get_exec().moe.elastic_ep_backend is not None:
+            return "elastic EP"
+    except Exception:  # noqa: BLE001 - config not published (unit tests): not elastic
+        pass
+    return None
+
+
+def build_online_placement(moe_layers: Sequence[torch.nn.Module]) -> Optional[OnlinePlacement]:
+    """The controller over the layers that opted in at init, or None (no layer, unsupported layout)."""
+    from sglang.srt.runtime_context import get_parallel
+
+    if not moe_layers:
+        return None
+    parallel = get_parallel()
+    group = parallel.tp_group
+    layers = [m for m in moe_layers if m.online_placement_eligible]
+    reason = (
+        "no layer runs the grouped NVFP4 experts with EP > 1"
+        if not layers
+        else unsupported_layout_reason(parallel, group)
+    )
+    if reason is not None:
+        if group.rank_in_group == 0:
+            logger.warning("Muse online expert placement off: %s", reason)
+        return None
+    return OnlinePlacement(
+        layers,
+        group=group,
+        ep_size=parallel.moe_ep_size,
+        # 60k rows x top-8 / 256 experts = ~1,875 routes per expert; rank-load error ~0.4% < min gain.
+        rows_to_switch=60000,
+    )
+
+
+__all__ = [
+    "OnlinePlacement",
+    "build_online_placement",
+    "count_routes",
+    "moe_row_bound",
+    "unsupported_layout_reason",
+]
diff --git a/python/sglang/srt/layers/muse_spark/muse_spark_online_placement_plan.py b/python/sglang/srt/layers/muse_spark/muse_spark_online_placement_plan.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/muse_spark_online_placement_plan.py
@@ -0,0 +1,175 @@
+"""Fit and move plan for Muse Spark's online expert placement (pure CPU torch, no sglang imports)."""
+
+from __future__ import annotations
+
+from typing import Dict, List, Optional, Sequence, Tuple
+
+import torch
+
+# Rows the decode hit term averages over: 8 verify rows per request x the power-of-two graph-capture batch sizes.
+_DECODE_ROWS = (8, 16, 32, 64, 128, 256)
+
+Round = List[Tuple[int, int, int]]
+
+
+def blend_weight(counts: torch.Tensor, top_k: int, alpha: float) -> torch.Tensor:
+    """float64 [E]: ``alpha`` x pair-load share + (1 - alpha) x score-weighted decode hit share."""
+    counts = counts.to(torch.float64)
+    pairs = counts.sum()
+    if float(pairs) <= 0.0:
+        return torch.full_like(counts, 1.0 / counts.numel())
+    load = counts / pairs
+    if alpha >= 1.0:
+        return load
+    pi = (counts * top_k / pairs).clamp(0.0, 1.0)
+    hit = torch.zeros_like(counts)
+    for rows in _DECODE_ROWS:
+        h = 1.0 - (1.0 - pi) ** rows
+        hit += h / float(h.sum())
+    return alpha * load + (1.0 - alpha) * hit / hit.sum()
+
+
+def sticky_lpt_owner(
+    weight: torch.Tensor, cur_rank: torch.Tensor, ep_size: int, stay_slack: float
+) -> torch.Tensor:
+    """int64 [E]: LPT, heaviest expert first onto the lightest rank with room (ties to the lowest rank),
+    except that an expert stays on its rank while that rank has room and is within ``stay_slack`` x mean load
+    of the lightest."""
+    num_experts = weight.numel()
+    per_rank = num_experts // ep_size
+    order = torch.sort(-weight, stable=True).indices.tolist()
+    w = weight.tolist()
+    cur = cur_rank.tolist()
+    slack = stay_slack * float(weight.sum()) / ep_size
+    total = [0.0] * ep_size
+    count = [0] * ep_size
+    owner = [0] * num_experts
+    for e in order:
+        best = -1
+        for r in range(ep_size):
+            if count[r] < per_rank and (best < 0 or total[r] < total[best]):
+                best = r
+        c = cur[e]
+        if count[c] < per_rank and total[c] - total[best] <= slack:
+            best = c
+        owner[e] = best
+        total[best] += w[e]
+        count[best] += 1
+    return torch.tensor(owner, dtype=torch.int64)
+
+
+def rank_excess(weight: torch.Tensor, rank_of_expert: torch.Tensor, ep_size: int) -> float:
+    per = torch.zeros(ep_size, dtype=torch.float64).index_add_(0, rank_of_expert, weight.to(torch.float64))
+    mean = float(per.mean())
+    return (float(per.max()) - mean) / mean if mean > 0 else 0.0
+
+
+def fit_layer(
+    counts: torch.Tensor,
+    p2l: torch.Tensor,
+    *,
+    ep_size: int,
+    top_k: int,
+    alpha: float,
+    min_gain: float,
+    stay_slack: float = 0.0,
+) -> Optional[torch.Tensor]:
+    """New rank of each logical expert, or None to keep the layer; ``counts`` are per logical id."""
+    weight = blend_weight(counts, top_k, alpha)
+    per_rank = p2l.numel() // ep_size
+    cur_rank = torch.empty_like(p2l)
+    cur_rank[p2l] = torch.arange(p2l.numel(), dtype=p2l.dtype) // per_rank
+    new_rank = sticky_lpt_owner(weight, cur_rank, ep_size, stay_slack)
+    gain = rank_excess(weight, cur_rank, ep_size) - rank_excess(weight, new_rank, ep_size)
+    if gain < min_gain or torch.equal(new_rank, cur_rank):
+        return None
+    return new_rank
+
+
+def _find_cycle(edges: List[List[int]], start: int, used: Sequence[bool]) -> Optional[List[int]]:
+    """A simple directed cycle through ``start`` over ranks not yet used this round (DFS, lowest rank first)."""
+    n = len(edges)
+    path = [start]
+    on_path = [False] * n
+    on_path[start] = True
+    nxt = [0] * n
+    while path:
+        u = path[-1]
+        advanced = False
+        while nxt[u] < n:
+            v = nxt[u]
+            nxt[u] += 1
+            if edges[u][v] == 0:
+                continue
+            if v == start:
+                return path
+            if not used[v] and not on_path[v]:
+                path.append(v)
+                on_path[v] = True
+                nxt[v] = 0
+                advanced = True
+                break
+        if not advanced:
+            on_path[u] = False
+            path.pop()
+    return None
+
+
+def plan_moves(
+    p2l: torch.Tensor, new_rank: torch.Tensor, ep_size: int
+) -> Tuple[List[Round], torch.Tensor]:
+    """Rounds that realise ``new_rank`` from ``p2l``, and the resulting physical -> logical table."""
+    num_experts = p2l.numel()
+    per_rank = num_experts // ep_size
+    layout = p2l.tolist()
+    target = new_rank.tolist()
+    # Outgoing slots per (rank, destination), in ascending slot order.
+    out: List[List[List[int]]] = [[[] for _ in range(ep_size)] for _ in range(ep_size)]
+    edges = [[0] * ep_size for _ in range(ep_size)]
+    for slot, expert in enumerate(layout):
+        src, dst = slot // per_rank, target[expert]
+        if src != dst:
+            out[src][dst].append(slot)
+            edges[src][dst] += 1
+    rounds: List[Round] = []
+    while any(any(row) for row in edges):
+        used = [False] * ep_size
+        sends: Dict[int, Tuple[int, int]] = {}  # rank -> (slot, destination rank)
+        for start in range(ep_size):
+            if used[start] or not any(edges[start]):
+                continue
+            cycle = _find_cycle(edges, start, used)
+            if cycle is None:
+                continue
+            for i, u in enumerate(cycle):
+                v = cycle[(i + 1) % len(cycle)]
+                used[u] = True
+                edges[u][v] -= 1
+                sends[u] = (out[u][v].pop(0), v)
+        assert sends, "plan_moves: no cycle in a balanced move graph"
+        recv_from = {dst: src for src, (_, dst) in sends.items()}
+        moved = {rank: layout[slot] for rank, (slot, _) in sends.items()}
+        step: Round = []
+        for rank in sorted(sends):
+            slot = sends[rank][0]
+            layout[slot] = moved[recv_from[rank]]
+            step.append((rank, slot, recv_from[rank]))
+        rounds.append(step)
+    return rounds, torch.tensor(layout, dtype=torch.int64)
+
+
+def invert(p2l: torch.Tensor) -> torch.Tensor:
+    l2p = torch.empty_like(p2l)
+    l2p[p2l] = torch.arange(p2l.numel(), dtype=p2l.dtype, device=p2l.device)
+    return l2p
+
+
+__all__ = [
+    "Round",
+    "blend_weight",
+    "fit_layer",
+    "invert",
+    "plan_moves",
+    "rank_excess",
+    "sticky_lpt_owner",
+]
diff --git a/python/sglang/srt/layers/muse_spark/muse_spark_prefill_attention.py b/python/sglang/srt/layers/muse_spark/muse_spark_prefill_attention.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/srt/layers/muse_spark/muse_spark_prefill_attention.py
@@ -0,0 +1,168 @@
+"""Muse FP8 prefill attention kernel in place of FA3's paged varlen call at extend (numerics:
+kernels/jit/csrc/muse_spark/prefill_attention.cuh); ``None`` keeps the FA3 call."""
+
+from __future__ import annotations
+
+import functools
+import logging
+from typing import Optional
+
+import torch
+
+from sglang.srt.model_executor.forward_batch_info import ForwardBatch, ForwardMode
+
+logger = logging.getLogger(__name__)
+
+# Below 1024 query rows the kernel leaves most SMs idle (one CTA per 24 tokens and kv head); FA3 runs.
+_MIN_QUERY_TOKENS = 1024
+# Same for a mixed batch's prefill rows when decode rows run apart: <= 33 blocks of 24 rows run FA3.
+_MIN_HEAD_TOKENS = 33 * 24 + 1
+_MIN_SPLIT_TOKENS = 256
+_MAX_STAGING_BYTES = 512 << 20
+_STAGING_BYTES_PER_SLOT = 8192 + 8192
+_KERNEL_CONFIG = dict(hand=8)
+_kernel_built = False
+
+
+@functools.cache
+def _supported_device(device: torch.device) -> bool:
+    return torch.cuda.get_device_capability(device)[0] == 9
+
+
+@functools.cache
+def _log_first_use() -> None:
+    logger.info("Muse FP8 prefill attention kernel on")
+
+
+def prepare_muse_prefill_attention() -> None:
+    """Build the kernel at model load; a failed build leaves FA3 in place."""
+    global _kernel_built
+    if not torch.cuda.is_available():
+        return
+    if not _supported_device(torch.device("cuda", torch.cuda.current_device())):
+        return
+    from sglang.kernels.ops.attention.muse_spark_prefill_attention import _module
+
+    try:
+        _module(**_KERNEL_CONFIG)
+    except Exception as err:
+        logger.warning("Muse FP8 prefill attention kernel unavailable, FA3 kept: %s", err)
+        return
+    _kernel_built = True
+
+
+def _layout_ok(layer, q: torch.Tensor, key_cache: torch.Tensor, value_cache: torch.Tensor) -> bool:
+    return (
+        layer.tp_q_head_num == 16
+        and layer.tp_k_head_num == 2
+        and layer.tp_v_head_num == 2
+        and layer.head_dim == 64
+        and layer.v_head_dim == 64
+        and q.dtype == torch.float8_e4m3fn
+        and key_cache.dtype == torch.float8_e4m3fn
+        and value_cache.dtype == torch.float8_e4m3fn
+        and key_cache.dim() == 4
+        and key_cache.stride()[2:] == (64, 1)
+        and key_cache.stride(0) == key_cache.shape[1] * key_cache.stride(1)
+        and value_cache.stride() == key_cache.stride()
+        and _supported_device(q.device)
+    )
+
+
+def maybe_muse_prefill_attention(
+    *,
+    layer,
+    forward_batch: ForwardBatch,
+    q: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    page_table: torch.Tensor,
+    cu_seqlens_q: torch.Tensor,
+    cache_seqlens: torch.Tensor,
+    max_seqlen_q: int,
+    max_seqlen_k: int,
+    window_size,
+    causal: bool,
+    softcap: float,
+    plain_call: bool,
+    out: Optional[torch.Tensor],
+    num_reqs: Optional[int] = None,
+) -> Optional[torch.Tensor]:
+    """bf16 [T, 16, 64] output when the kernel covers this call, else None. ``plain_call``: no
+    local / cascade attention, LSE, descales, sinks, masks or other FA3 extras."""
+    if not _kernel_built:
+        return None
+    mode = forward_batch.forward_mode
+    if not (plain_call and causal and not softcap and (mode == ForwardMode.EXTEND or mode.is_mixed())):
+        return None
+    if tuple(window_size) != (-1, -1) and (window_size[0] < 0 or window_size[1] != 0):
+        return None
+    if not _layout_ok(layer, q, key_cache, value_cache):
+        return None
+    lens, seq_lens_sum = forward_batch.extend_seq_lens_cpu, forward_batch.seq_lens_sum
+    lens = lens[:num_reqs] if num_reqs else lens
+    if lens is None or seq_lens_sum is None or len(lens) != cache_seqlens.shape[0]:
+        return None
+    splits = 1 if window_size[0] >= 0 else _key_splits(lens, min(max_seqlen_k, seq_lens_sum), q.device)
+    if q.shape[0] < (_MIN_SPLIT_TOKENS if splits > 1 else _MIN_HEAD_TOKENS if num_reqs else _MIN_QUERY_TOKENS):
+        return None
+    from sglang.kernels.ops.attention.muse_spark_prefill_attention import (
+        muse_spark_prefill_attention,
+        staging_slots,
+    )
+
+    window = window_size[0] + 1 if window_size[0] >= 0 else 0
+    slots = staging_slots(
+        num_reqs=len(lens), total_q=q.shape[0], seq_lens_sum=seq_lens_sum, window=window
+    )
+    if slots * _STAGING_BYTES_PER_SLOT > _MAX_STAGING_BYTES:
+        return None
+    if out is None:
+        out = q.new_empty(q.shape, dtype=torch.bfloat16)
+    _log_first_use()
+    return muse_spark_prefill_attention(
+        q,
+        key_cache,
+        value_cache,
+        page_table,
+        cu_seqlens_q,
+        cache_seqlens,
+        softmax_scale=layer.scaling,
+        window=window,
+        max_seqlen_q=max_seqlen_q,
+        max_seqlen_k=min(max_seqlen_k, seq_lens_sum),
+        seq_lens_sum=seq_lens_sum,
+        out=out,
+        splits=splits,
+        **_KERNEL_CONFIG,
+    )
+
+
+def split_decode_rows(*, layer, forward_batch: ForwardBatch, q, key_cache, value_cache, num_reqs: int, max_keys: int):
+    """(prefill requests, their rows) of a mixed batch whose trailing one-token rows can run decode-shaped, else None."""
+    lens = forward_batch.extend_seq_lens_cpu
+    if not _kernel_built or not forward_batch.forward_mode.is_mixed() or lens is None:
+        return None
+    if len(lens) != num_reqs or torch.cuda.is_current_stream_capturing() or not _layout_ok(layer, q, key_cache, value_cache):
+        return None
+    head = num_reqs
+    while head and lens[head - 1] == 1:
+        head -= 1
+    rows = sum(lens[:head])
+    if not 0 < head < num_reqs or rows >= _MIN_HEAD_TOKENS and _key_splits(lens[:head], max_keys, q.device) == 1 and (sum(lens) < _MIN_QUERY_TOKENS or _waves(lens[:head], q.device) == _waves(lens, q.device)):
+        return None  # the joint call costs no more (FA3 below 1024 rows, or the kernel in as many waves)
+    return head, rows
+
+
+def _waves(lens, device) -> int:
+    ctas = 2 * sum(-(-n // 24) for n in lens)  # attn_kernel: one CTA per 24 tokens and kv head
+    return -(-ctas // torch.cuda.get_device_properties(device).multi_processor_count)
+
+
+def _key_splits(lens, max_keys: int, device) -> int:
+    """Key splits per query block minimizing waves x (128-key tiles per split + 8); partials stay under 64 MB."""
+    tiles = -(-max_keys // 128)
+    if tiles < 64:
+        return 1
+    cost = [_waves(lens * s, device) * (tiles / s + 8) for s in range(1, min(8, 16384 // sum(lens)) + 1)]
+    return 1 + cost.index(min(cost)) if cost and min(cost) < 0.9 * cost[0] else 1
