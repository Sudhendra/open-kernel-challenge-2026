+              asm volatile("cp.async.bulk.commit_group;" ::: "memory");
+              asm volatile("cp.async.bulk.wait_group.read 0;" ::: "memory");
+            }
+          } else if (FINE != 0 && fa.g2.rdst) {  // GEMM2 rows of 256 bytes to their pair rows, pad rows skipped
+            const size_t off = dst - fa.g2.out;
